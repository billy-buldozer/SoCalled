// ==========================================
// FUNKCJE POMOCNICZE
// ==========================================

function makeRequestId(): string {
  return (
    Date.now().toString(36) +
    "-" +
    Math.random().toString(36).slice(2, 10)
  );
}

function formatMessageTime(value: string): string {
  return new Date(value).toLocaleTimeString("pl-PL", {
    hour: "2-digit",
    minute: "2-digit",
  });
}

function mergeRoom(
  incoming: ServerRoom,
  existing?: Room
): Room {
  return {
    ...incoming,
    lastMessage:
      existing?.lastMessage ?? "Brak wiadomości",
    lastTime: existing?.lastTime ?? "—",
    unread: existing?.unread ?? 0,
  };
}

function messagePreview(
  message: ServerMessage | null
): string {
  if (!message) {
    return "Brak wiadomości";
  }

  if (message.videoId) {
    return message.text
      ? `🎬 ${message.text}`
      : "🎬 Film";
  }

  if (message.image) {
    return message.text
      ? `📷 ${message.text}`
      : "📷 Zdjęcie";
  }

  return message.text;
}

function roleLabel(role: MemberRole): string {
  if (role === "owner") return "Właściciel";
  if (role === "moderator") return "Moderator";
  return "Uczestnik";
}

function RoleIcon({ role }: { role: MemberRole }) {
  if (role === "owner") return <Crown size={14} />;
  if (role === "moderator") return <ShieldCheck size={14} />;
  return <UserRound size={14} />;
}

function RoomGlyph({ icon }: { icon: RoomIcon }) {
  const props = {
    size: 24,
    strokeWidth: 1.8,
  };

  switch (icon) {
    case "game":
      return <Gamepad2 {...props} />;
    case "code":
      return <Code2 {...props} />;
    case "music":
      return <Music2 {...props} />;
    case "camera":
      return <Camera {...props} />;
    case "coffee":
      return <Coffee {...props} />;
    case "globe":
      return <Globe2 {...props} />;
    default:
      return <Hash {...props} />;
  }
}

function RoomVisual({ room }: { room: Room }) {
  if (room.image) {
    return (
      <img
        className="room-custom-image"
        src={room.image}
        alt=""
      />
    );
  }

  if (room.isPrivate) {
    return <LockKeyhole size={24} />;
  }

  return <RoomGlyph icon={room.icon} />;
}

function videoUrl(id: string): string {
  return `/api/videos/${encodeURIComponent(id)}`;
}

function formatFileSize(size: number): string {
  return `${(size / (1024 * 1024)).toFixed(1)} MB`;
}

function videoMimeType(file: File): string | null {
  const mimeType = file.type.toLowerCase();

  if (
    mimeType === "video/mp4" ||
    mimeType === "video/webm" ||
    mimeType === "video/quicktime"
  ) {
    return mimeType;
  }

  const lowerName = file.name.toLowerCase();

  if (lowerName.endsWith(".mp4")) return "video/mp4";
  if (lowerName.endsWith(".webm")) return "video/webm";
  if (lowerName.endsWith(".mov")) return "video/quicktime";

  return null;
}

// ==========================================
// POBIERANIE ZDJĘĆ W PNG
// ==========================================

async function downloadImage(
  imageData: string,
  messageId: string
): Promise<void> {
  const image = new Image();
  image.src = imageData;

  await image.decode();

  if (!image.naturalWidth || !image.naturalHeight) {
    throw new Error("Nieprawidłowe wymiary zdjęcia.");
  }

  const canvas = document.createElement("canvas");
  canvas.width = image.naturalWidth;
  canvas.height = image.naturalHeight;

  const context = canvas.getContext("2d");

  if (!context) {
    throw new Error("Nie można utworzyć obrazu.");
  }

  context.drawImage(image, 0, 0);

  const pngBlob = await new Promise<Blob>(
    (resolve, reject) => {
      canvas.toBlob(
        (blob) => {
          if (!blob || blob.type !== "image/png") {
            reject(
              new Error("Nie udało się utworzyć PNG.")
            );
            return;
          }

          resolve(blob);
        },
        "image/png"
      );
    }
  );

  const objectUrl = URL.createObjectURL(pngBlob);
  const link = document.createElement("a");

  link.href = objectUrl;
  link.download =
    `socalled-${messageId.slice(0, 8)}.png`;

  document.body.appendChild(link);
  link.click();
  link.remove();

  window.setTimeout(() => {
    URL.revokeObjectURL(objectUrl);
  }, 4000);
}

// ==========================================
// KOMPRESJA ZDJĘĆ POKOJÓW
// ==========================================

function prepareRoomImage(file: File): Promise<string> {
  return new Promise((resolve, reject) => {
    if (file.size > 8 * 1024 * 1024) {
      reject(
        new Error("Zdjęcie może mieć maksymalnie 8 MB.")
      );
      return;
    }

    if (!file.type.startsWith("image/")) {
      reject(new Error("Wybierz plik graficzny."));
      return;
    }

    const objectUrl = URL.createObjectURL(file);
    const image = new Image();

    image.onload = () => {
      URL.revokeObjectURL(objectUrl);

      try {
        const canvas =
          document.createElement("canvas");

        const context = canvas.getContext("2d");

        if (!context) {
          throw new Error(
            "Nie można przetworzyć zdjęcia."
          );
        }

        for (const maxSize of [
          512, 400, 320, 256, 192,
        ]) {
          const scale = Math.min(
            1,
            maxSize / Math.max(
              image.width,
              image.height
            )
          );

          canvas.width = Math.max(
            1,
            Math.round(image.width * scale)
          );

          canvas.height = Math.max(
            1,
            Math.round(image.height * scale)
          );

          context.clearRect(
            0, 0, canvas.width, canvas.height
          );

          context.drawImage(
            image,
            0,
            0,
            canvas.width,
            canvas.height
          );

          let result = canvas.toDataURL(
            "image/webp",
            0.72
          );

          if (!result.startsWith("data:image/webp;")) {
            result = canvas.toDataURL(
              "image/jpeg",
              0.72
            );
          }

          if (result.length <= 235_000) {
            resolve(result);
            return;
          }
        }

        reject(
          new Error("Nie udało się zmniejszyć zdjęcia.")
        );
      } catch (error) {
        reject(error);
      }
    };

    image.onerror = () => {
      URL.revokeObjectURL(objectUrl);
      reject(new Error("Nie można odczytać zdjęcia."));
    };

    image.src = objectUrl;
  });
}

// ==========================================
// KOMPRESJA ZDJĘĆ WIADOMOŚCI
// ==========================================

function prepareMessageImage(
  file: File
): Promise<string> {
  return new Promise((resolve, reject) => {
    const acceptedTypes = [
      "image/jpeg",
      "image/png",
      "image/webp",
    ];

    if (!acceptedTypes.includes(file.type)) {
      reject(
        new Error(
          "Obsługiwane formaty: JPG, PNG i WebP."
        )
      );
      return;
    }

    if (file.size > 10 * 1024 * 1024) {
      reject(
        new Error(
          "Plik wejściowy może mieć maksymalnie 10 MB."
        )
      );
      return;
    }

    const objectUrl = URL.createObjectURL(file);
    const image = new Image();

    image.onload = () => {
      URL.revokeObjectURL(objectUrl);

      try {
        if (
          !image.naturalWidth ||
          !image.naturalHeight
        ) {
          throw new Error(
            "Nie udało się odczytać wymiarów zdjęcia."
          );
        }

        const canvas =
          document.createElement("canvas");

        const context = canvas.getContext("2d");

        if (!context) {
          throw new Error(
            "Nie udało się przygotować zdjęcia."
          );
        }

        const sizes = [
          960, 800, 640, 512, 400, 320, 240,
        ];

        const qualities = [
          0.82, 0.72, 0.62, 0.5,
        ];

        for (const maxSize of sizes) {
          const scale = Math.min(
            1,
            maxSize / Math.max(
              image.naturalWidth,
              image.naturalHeight
            )
          );

          canvas.width = Math.max(
            1,
            Math.round(
              image.naturalWidth * scale
            )
          );

          canvas.height = Math.max(
            1,
            Math.round(
              image.naturalHeight * scale
            )
          );

          for (const quality of qualities) {
            context.clearRect(
              0,
              0,
              canvas.width,
              canvas.height
            );

            context.drawImage(
              image,
              0,
              0,
              canvas.width,
              canvas.height
            );

            let result = canvas.toDataURL(
              "image/webp",
              quality
            );

            if (
              !result.startsWith(
                "data:image/webp;"
              )
            ) {
              context.fillStyle = "#ffffff";

              context.globalCompositeOperation =
                "destination-over";

              context.fillRect(
                0,
                0,
                canvas.width,
                canvas.height
              );

              context.globalCompositeOperation =
                "source-over";

              result = canvas.toDataURL(
                "image/jpeg",
                quality
              );
            }

            if (result.length <= 235_000) {
              resolve(result);
              return;
            }
          }
        }

        reject(
          new Error(
            "Zdjęcie jest zbyt złożone do kompresji."
          )
        );
      } catch (error) {
        reject(error);
      }
    };

    image.onerror = () => {
      URL.revokeObjectURL(objectUrl);
      reject(new Error("Nie można odczytać zdjęcia."));
    };

    image.src = objectUrl;
  });
}

