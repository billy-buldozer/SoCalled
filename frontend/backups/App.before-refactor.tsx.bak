// ==========================================
// TYPY
// ==========================================

type RoomIcon =
  | "hash"
  | "game"
  | "code"
  | "music"
  | "camera"
  | "coffee"
  | "globe";

type MobileScreen = "rooms" | "chat" | "details";
type DetailsTab = "about" | "settings";
type SocketStatus = "connecting" | "online" | "offline";
type MemberRole = "owner" | "moderator" | "member";

type ServerRoom = {
  id: string;
  name: string;
  icon: RoomIcon;
  description: string;
  topic: string;
  image: string | null;
  isPrivate: boolean;
  ownerId: string | null;
  memberCount: number;
  onlineCount: number;
};

type Room = ServerRoom & {
  lastMessage: string;
  lastTime: string;
  unread: number;
};

type RoomMember = {
  clientId: string;
  username: string;
  nickname: string | null;
  displayName: string;
  role: MemberRole;
  online: boolean;
};

type ReplyPreview = {
  id: string;
  clientId: string;
  author: string;
  text: string;
  deleted: boolean;
};

type ForwardOrigin = {
  roomId: string;
  roomName: string;
  author: string;
  messageId: string;
};

type Reactions = Record<string, string[]>;

type ChatMessage = {
  id: string;
  roomId: string;
  clientId: string;
  author: string;
  time: string;
  text: string;
  image: string | null;
  videoId: string | null;
  mine: boolean;
  editedAt: string | null;
  replyTo: ReplyPreview | null;
  reactions: Reactions;
  forwardedFrom: ForwardOrigin | null;
};

type ServerMessage = {
  id: string;
  roomId: string;
  clientId: string;
  author: string;
  time: string;
  text: string;
  image?: string | null;
  videoId?: string | null;
  editedAt?: string | null;
  replyTo?: ReplyPreview | null;
  reactions?: Reactions;
  forwardedFrom?: ForwardOrigin | null;
};

type TypingUser = {
  clientId: string;
  displayName: string;
};

type ImageViewer = {
  image: string;
  author: string;
  messageId: string;
};

type ForwardNotice = {
  roomId: string;
  roomName: string;
};

type LastTap = {
  messageId: string;
  time: number;
  x: number;
  y: number;
};

type TouchStart = {
  x: number;
  y: number;
};

type HeartBurst = {
  messageId: string;
  sequence: number;
};

type VideoUploadResponse = {
  id: string;
  url: string;
  size: number;
  mimeType: string;
};

