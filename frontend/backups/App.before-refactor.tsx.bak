  const [memberSaving, setMemberSaving] =
    useState(false);

  const [memberError, setMemberError] =
    useState("");

  const [memberSuccess, setMemberSuccess] =
    useState("");

  // ========================================
  // TYMCZASOWA TOŻSAMOŚĆ
  // ========================================

  const [clientId] = useState(() => {
    const saved = sessionStorage.getItem(
      "socalled_client_id"
    );

    if (saved) return saved;

    const generated = makeRequestId();

    sessionStorage.setItem(
      "socalled_client_id",
      generated
    );

    return generated;
  });

  const [nickname] = useState(() => {
    const saved = sessionStorage.getItem(
      "socalled_nickname"
    );

    if (saved) return saved;

    const generated =
      "Gosc-" +
      Math.random().toString(36).slice(2, 6);

    sessionStorage.setItem(
      "socalled_nickname",
      generated
    );

    return generated;
  });

  // ========================================
  // AKTUALNY POKÓJ
  // ========================================

  const activeRoom =
    rooms.find(
      (room) => room.id === activeRoomId
    ) ?? rooms[0];

  const activeMembers =
    membersByRoom[activeRoomId] ?? [];

  const currentMember = activeMembers.find(
    (member) => member.clientId === clientId
  );

  const myRole: MemberRole =
    currentMember?.role ??
    (activeRoom.ownerId === clientId
      ? "owner"
      : "member");

  const isRoomOwner =
    activeRoom.ownerId === clientId;

  const canEditRoom =
    activeRoom.ownerId === null ||
    isRoomOwner;

  const canModerateMessages =
    myRole === "owner" ||
    myRole === "moderator";

  const theme =
    themeOptions.find(
      (option) => option.id === themeId
    ) ?? themeOptions[0];

  // ========================================
  // FILTROWANIE
  // ========================================

  const roomMessages = useMemo(
    () =>
      messages.filter(
        (message) =>
          message.roomId === activeRoomId
      ),
    [messages, activeRoomId]
  );

  const filteredRooms = useMemo(
    () =>
      rooms.filter((room) =>
        room.name
          .toLocaleLowerCase("pl-PL")
          .includes(
            search.toLocaleLowerCase("pl-PL")
          )
      ),
    [rooms, search]
  );

  const forwardRooms = rooms.filter(
    (room) => room.id !== activeRoomId
  );

  const otherTypingUsers = typingUsers.filter(
    (user) => user.clientId !== clientId
  );

  const typingLabel =
    otherTypingUsers.length === 1
      ? `${otherTypingUsers[0].displayName} pisze...`
      : otherTypingUsers.length === 2
        ? `${otherTypingUsers[0].displayName} i ${otherTypingUsers[1].displayName} piszą...`
        : otherTypingUsers.length > 2
          ? "Kilka osób pisze..."
          : "";

  // ========================================
  // EFEKTY
  // ========================================

  useEffect(() => {
    setRoomName(activeRoom.name);
    setRoomDescription(activeRoom.description);
    setRoomTopic(activeRoom.topic);
    setRoomIcon(activeRoom.icon);
    setRoomImage(activeRoom.image);
    setRoomError("");
    setRoomSuccess("");
  }, [
    activeRoom.id,
    activeRoom.name,
    activeRoom.description,
    activeRoom.topic,
    activeRoom.icon,
    activeRoom.image,
  ]);

  useEffect(() => {
    setEditingMemberId(null);
    setMemberNickname("");
    setMemberError("");
    setMemberSuccess("");
  }, [activeRoomId]);

  useEffect(() => {
    if (!imageViewer) return;

    function handleEscape(event: KeyboardEvent) {
      if (event.key === "Escape") {
        setImageViewer(null);
      }
    }

    window.addEventListener(
      "keydown",
      handleEscape
    );

    return () => {
      window.removeEventListener(
        "keydown",
        handleEscape
      );
    };
  }, [imageViewer]);

  useEffect(() => {
    if (!heartBurst) return;

    const timer = window.setTimeout(() => {
      setHeartBurst(null);
    }, HEART_ANIMATION_DURATION);

    return () => window.clearTimeout(timer);
  }, [heartBurst]);

  useEffect(() => {
    return () => {
      if (imageClickTimerRef.current !== undefined) {
        window.clearTimeout(
          imageClickTimerRef.current
        );
      }

      videoAbortRef.current?.abort();
    };
  }, []);

  function cancelPendingImageOpen() {
    if (imageClickTimerRef.current !== undefined) {
      window.clearTimeout(
        imageClickTimerRef.current
      );

      imageClickTimerRef.current = undefined;
    }
  }

  function reconnectNow() {
    setSocketStatus("connecting");

    setConnectionVersion(
      (previous) => previous + 1
    );
  }

  // ========================================
  // WEBSOCKET
  // ========================================

  useEffect(() => {
    let disposed = false;
    let currentSocket: WebSocket | null = null;

    let reconnectTimer: number | undefined;
    let connectTimer: number | undefined;
    let heartbeatTimer: number | undefined;
    let pongTimer: number | undefined;

    const params = new URLSearchParams({
      client_id: clientId,
      nickname,
    });

    const protocol =
      window.location.protocol === "https:"
        ? "wss"
        : "ws";

    const url =
      `${protocol}://${window.location.hostname}:8000` +
      `/ws/rooms/${encodeURIComponent(activeRoomId)}` +
      `?${params.toString()}`;

    // ======================================
    // KONWERSJA WIADOMOŚCI
    // ======================================

    function convertMessage(
      message: ServerMessage
    ): ChatMessage {
      return {
        id: message.id,
        roomId: message.roomId,
        clientId: message.clientId,
        author: message.author,
        time: formatMessageTime(message.time),
        text: message.text,
        image: message.image ?? null,
        videoId: message.videoId ?? null,
        mine: message.clientId === clientId,
        editedAt: message.editedAt ?? null,
        replyTo: message.replyTo ?? null,
        reactions: message.reactions ?? {},
        forwardedFrom:
          message.forwardedFrom ?? null,
      };
    }

    function updateRoomPreview(
      latest: ServerMessage | null
    ) {
      setRooms((previous) =>
        previous.map((room) =>
          room.id === activeRoomId
            ? {
                ...room,
                lastMessage: messagePreview(latest),
                lastTime: latest
                  ? formatMessageTime(latest.time)
                  : "—",
              }
            : room
        )
      );
    }

    function upsertRoom(incoming: ServerRoom) {
      setRooms((previous) => {
        const existing = previous.find(
          (room) => room.id === incoming.id
        );

        if (existing) {
          return previous.map((room) =>
            room.id === incoming.id
              ? mergeRoom(incoming, room)
              : room
          );
        }

        return [
          ...previous,
          mergeRoom(incoming),
        ];
      });
    }

    // ======================================
    // TIMERY
    // ======================================

    function clearConnectionTimers() {
      if (connectTimer !== undefined) {
        window.clearTimeout(connectTimer);
        connectTimer = undefined;
      }

      if (heartbeatTimer !== undefined) {
        window.clearInterval(heartbeatTimer);
        heartbeatTimer = undefined;
      }

      if (pongTimer !== undefined) {
        window.clearTimeout(pongTimer);
        pongTimer = undefined;
      }
    }

    function clearReconnectTimer() {
      if (reconnectTimer !== undefined) {
        window.clearTimeout(reconnectTimer);
        reconnectTimer = undefined;
      }
    }

    function scheduleReconnect() {
      if (
        disposed ||
        reconnectTimer !== undefined
      ) {
        return;
      }

      reconnectTimer = window.setTimeout(() => {
        reconnectTimer = undefined;
        connect();
      }, RECONNECT_DELAY);
    }

    function sendPing(socket: WebSocket) {
      if (disposed || document.hidden) return;
      if (currentSocket !== socket) return;

      if (
        socket.readyState !== WebSocket.OPEN
      ) {
        return;
      }

      if (pongTimer !== undefined) return;

      try {
        socket.send(
          JSON.stringify({
            type: "ping",
          })
        );

        pongTimer = window.setTimeout(() => {
          pongTimer = undefined;

          if (
            !disposed &&
            currentSocket === socket &&
            socket.readyState === WebSocket.OPEN
          ) {
            socket.close(
              4000,
              "Heartbeat timeout"
            );
          }
        }, HEARTBEAT_TIMEOUT);
      } catch (error) {
        console.error(
          "[SoCalled] Heartbeat:",
          error
        );

        socket.close();
      }
    }

    // ======================================
    // ŁĄCZENIE
    // ======================================

    function connect() {
      if (disposed) return;

      if (
        currentSocket &&
        (
          currentSocket.readyState === WebSocket.OPEN ||
          currentSocket.readyState === WebSocket.CONNECTING
        )
      ) {
        return;
      }

      clearReconnectTimer();
      clearConnectionTimers();

      setSocketStatus("connecting");

      let socket: WebSocket;

      try {
        socket = new WebSocket(url);
      } catch (error) {
        console.error(
          "[SoCalled] WebSocket:",
          error
        );

        setSocketStatus("offline");
        scheduleReconnect();
        return;
      }

      currentSocket = socket;
      socketRef.current = socket;

      connectTimer = window.setTimeout(() => {
        if (
          !disposed &&
          currentSocket === socket &&
          socket.readyState === WebSocket.CONNECTING
        ) {
          socket.close();
        }
      }, CONNECT_TIMEOUT);

      socket.onopen = () => {
        if (
          disposed ||
          currentSocket !== socket
        ) {
          return;
        }

        if (connectTimer !== undefined) {
          window.clearTimeout(connectTimer);
          connectTimer = undefined;
        }

        setSocketStatus("online");
        typingSentRef.current = false;

        console.log(
          "[SoCalled] Połączono:",
          activeRoomId
        );

        sendPing(socket);

        heartbeatTimer = window.setInterval(
          () => sendPing(socket),
          HEARTBEAT_INTERVAL
        );
      };

      // ====================================
      // ZDARZENIA Z SERWERA
      // ====================================

      socket.onmessage = (event) => {
        if (
          disposed ||
          currentSocket !== socket
        ) {
          return;
        }

        try {
          const data = JSON.parse(event.data);

          // PING / PONG

          if (data.type === "pong") {
            if (pongTimer !== undefined) {
              window.clearTimeout(pongTimer);
              pongTimer = undefined;
            }
            return;
          }

          // LISTA POKOJÓW

          if (
            data.type === "rooms_snapshot" &&
            Array.isArray(data.rooms)
          ) {
            const incoming =
              data.rooms as ServerRoom[];

            setRooms((previous) =>
              incoming.map((item) => {
                const existing = previous.find(
                  (room) => room.id === item.id
                );

                return mergeRoom(
                  item,
                  existing
                );
              })
            );

            return;
          }

          // NOWY POKÓJ

          if (
            data.type === "room_created" &&
            data.room
          ) {
            const incoming =
              data.room as ServerRoom;

            upsertRoom(incoming);

            if (
              data.requestId &&
              data.requestId ===
                createRequestRef.current &&
              data.createdBy === clientId
            ) {
              createRequestRef.current = null;

              setCreateBusy(false);
              setCreateOpen(false);
              setCreateError("");
              setNewRoomName("");
              setNewRoomPrivate(false);

              setActiveRoomId(incoming.id);
              setMobileScreen("chat");
              setDetailsTab("about");
              setSocketStatus("connecting");

              setDraft("");
              setReplyTarget(null);
              setAttachedImage(null);
              setAttachedVideoId(null);
              setReactionPickerId(null);
              setImageError("");
              setVideoError("");
              setForwardTarget(null);
              setForwardNotice(null);
            }

            return;
          }

          // AKTUALIZACJA POKOJU

          if (
            data.type === "room_updated" &&
            data.room
          ) {
            upsertRoom(
              data.room as ServerRoom
            );

            if (
              data.requestId &&
              data.requestId ===
                saveRequestRef.current &&
              data.updatedBy === clientId
            ) {
              saveRequestRef.current = null;

              setRoomSaving(false);
              setRoomError("");

              setRoomSuccess(
                "Zmiany zapisane i zsynchronizowane."
              );
            }

            return;
          }

          // UCZESTNICY

          if (
            data.type === "room_presence" &&
            typeof data.roomId === "string" &&
            Array.isArray(data.members)
          ) {
            const roomId =
              data.roomId as string;

            setMembersByRoom((previous) => ({
              ...previous,
              [roomId]: data.members as RoomMember[],
            }));

            setRooms((previous) =>
              previous.map((room) =>
                room.id === roomId
                  ? {
                      ...room,
                      memberCount:
                        Number(data.memberCount) || 0,
                      onlineCount:
                        Number(data.onlineCount) || 0,
                    }
                  : room
              )
            );

            if (
              data.requestId &&
              data.requestId ===
                memberRequestRef.current &&
              data.updatedBy === clientId
            ) {
              memberRequestRef.current = null;

              setMemberSaving(false);
              setEditingMemberId(null);
              setMemberError("");

              setMemberSuccess(
                "Zmiana została zapisana."
              );
            }

            return;
          }

          // ZMIANA NICKU AUTORA

          if (
            data.type === "message_author_changed" &&
            typeof data.roomId === "string" &&
            typeof data.clientId === "string" &&
            typeof data.author === "string"
          ) {
            setMessages((previous) =>
              previous.map((message) => {
                if (message.roomId !== data.roomId) {
                  return message;
                }

                const updatedReply =
                  message.replyTo &&
                  message.replyTo.clientId === data.clientId &&
                  !message.replyTo.deleted
                    ? {
                        ...message.replyTo,
                        author: data.author as string,
                      }
                    : message.replyTo;

                return {
                  ...message,
                  author:
                    message.clientId === data.clientId
                      ? data.author
                      : message.author,
                  replyTo: updatedReply,
                };
              })
            );

            return;
          }

          // WSKAŹNIK PISANIA

          if (
            data.type === "typing_status" &&
            data.roomId === activeRoomId &&
            Array.isArray(data.users)
          ) {
            setTypingUsers(
              (data.users as TypingUser[]).filter(
                (user) => user.clientId !== clientId
              )
            );

            return;
          }

          // AKTYWNOŚĆ INNEGO POKOJU

          if (
            data.type === "room_activity" &&
            typeof data.roomId === "string"
          ) {
            setRooms((previous) =>
              previous.map((room) => {
                if (room.id !== data.roomId) {
                  return room;
                }

                const isCurrent =
                  room.id === activeRoomId;

                return {
                  ...room,
                  lastMessage:
                    typeof data.preview === "string"
                      ? data.preview
                      : room.lastMessage,
                  lastTime:
                    typeof data.time === "string"
                      ? formatMessageTime(data.time)
                      : room.lastTime,
                  unread: isCurrent
                    ? room.unread
                    : room.unread + 1,
                };
              })
            );

            return;
          }

          // POTWIERDZENIE PRZEKAZANIA

          if (
            data.type === "message_forwarded" &&
            data.requestId ===
              forwardRequestRef.current
          ) {
            forwardRequestRef.current = null;

            setForwardBusy(false);
            setForwardError("");
            setForwardTarget(null);

            setForwardNotice({
              roomId: data.targetRoomId,
              roomName: data.targetRoomName,
            });

            return;
          }

          // HISTORIA WIADOMOŚCI

          if (
            data.type === "history" &&
            Array.isArray(data.messages)
          ) {
            const history = (
              data.messages as ServerMessage[]
            ).map(convertMessage);

            setMessages((previous) => [
              ...previous.filter(
                (message) =>
                  message.roomId !== activeRoomId
              ),
              ...history,
            ]);

            const latest =
              data.messages.length > 0
                ? data.messages[
                    data.messages.length - 1
                  ] as ServerMessage
                : null;

            updateRoomPreview(latest);

            return;
          }

          // NOWA WIADOMOŚĆ

          if (
            data.type === "message_created" &&
            data.message
          ) {
            const serverMessage =
              data.message as ServerMessage;

            const message =
              convertMessage(serverMessage);

            setMessages((previous) => {
              if (
                previous.some(
                  (item) => item.id === message.id
                )
              ) {
                return previous;
              }

              return [
                ...previous,
                message,
              ];
            });

            updateRoomPreview(serverMessage);

            return;
          }

          // EDYCJA WIADOMOŚCI

          if (
            data.type === "message_updated" &&
            data.message
          ) {
            const updated = convertMessage(
              data.message as ServerMessage
            );

            setMessages((previous) =>
              previous.map((message) =>
                message.id === updated.id
                  ? updated
                  : message
              )
            );

            updateRoomPreview(
              (data.lastMessage as ServerMessage | null) ??
                null
            );

            setEditingId((current) =>
              current === updated.id
                ? null
                : current
            );

            setPendingEditId((current) =>
              current === updated.id
                ? null
                : current
            );

            setActionMenuId(null);
            setActionError("");

            return;
          }

          // USUNIĘTA WIADOMOŚĆ

          if (
            data.type === "message_deleted" &&
            typeof data.messageId === "string"
          ) {
            const removedId =
              data.messageId as string;

            setMessages((previous) =>
              previous.filter(
                (message) =>
                  message.id !== removedId
              )
            );

            updateRoomPreview(
              (data.lastMessage as ServerMessage | null) ??
                null
            );

            setEditingId((current) =>
              current === removedId
                ? null
                : current
            );

            setPendingEditId((current) =>
              current === removedId
                ? null
                : current
            );

            setReplyTarget((current) =>
              current?.id === removedId
                ? null
                : current
            );

            heartPendingRef.current.delete(
              removedId
            );

            setReactionPickerId(null);
            setActionMenuId(null);
            setActionError("");

            return;
          }

          // REAKCJE

          if (
            data.type === "message_reactions_updated" &&
            typeof data.messageId === "string"
          ) {
            const messageId =
              data.messageId as string;

            setMessages((previous) =>
              previous.map((message) =>
                message.id === messageId
                  ? {
                      ...message,
                      reactions:
                        (data.reactions as Reactions) ?? {},
                    }
                  : message
              )
            );

            heartPendingRef.current.delete(
              messageId
            );

            return;
          }

          // AKTUALIZACJA CYTATU

          if (
            data.type === "message_reply_updated" &&
            typeof data.messageId === "string"
          ) {
            setMessages((previous) =>
              previous.map((message) =>
                message.id === data.messageId
                  ? {
                      ...message,
                      replyTo:
                        (data.replyTo as ReplyPreview) ??
                        null,
                    }
                  : message
              )
            );

            return;
          }

          // BŁĄD SERWERA

          if (data.type === "error") {
            const message =
              typeof data.message === "string"
                ? data.message
                : "Nie udało się wykonać operacji.";

            console.warn(
              "[SoCalled]",
              message
            );

            if (createRequestRef.current) {
              createRequestRef.current = null;
              setCreateBusy(false);
              setCreateError(message);

            } else if (saveRequestRef.current) {
              saveRequestRef.current = null;
              setRoomSaving(false);
              setRoomError(message);

            } else if (memberRequestRef.current) {
              memberRequestRef.current = null;
              setMemberSaving(false);
              setMemberError(message);

            } else if (forwardRequestRef.current) {
              forwardRequestRef.current = null;
              setForwardBusy(false);
              setForwardError(message);

            } else {
              setActionError(message);
            }

            heartPendingRef.current.clear();
            setPendingEditId(null);
          }

        } catch (error) {
          console.error(
            "[SoCalled] Błąd zdarzenia:",
            error
          );
        }
      };

      // ROZŁĄCZENIE

      socket.onclose = (event) => {
        if (
          disposed ||
          currentSocket !== socket
        ) {
          return;
        }

        clearConnectionTimers();

        currentSocket = null;

        if (socketRef.current === socket) {
          socketRef.current = null;
        }

        setSocketStatus("offline");
        setTypingUsers([]);
        typingSentRef.current = false;
        heartPendingRef.current.clear();

        setPendingEditId(null);
        setCreateBusy(false);
        setRoomSaving(false);
        setMemberSaving(false);
        setForwardBusy(false);

        createRequestRef.current = null;
        saveRequestRef.current = null;
        memberRequestRef.current = null;
        forwardRequestRef.current = null;

        console.warn(
          "[SoCalled] Rozłączono:",
          event.code,
          event.reason
        );

        scheduleReconnect();
      };

      socket.onerror = () => {
        if (
          disposed ||
          currentSocket !== socket
        ) {
          return;
        }

        console.warn(
          "[SoCalled] Problem z WebSocket:",
          url
        );
      };
    }

    function checkConnection() {
      if (
        disposed ||
        document.hidden
      ) {
        return;
      }

      const socket = currentSocket;

      if (!socket) {
        clearReconnectTimer();
        connect();
        return;
      }

      if (
        socket.readyState === WebSocket.OPEN
      ) {
        sendPing(socket);
        return;
      }

      if (
        socket.readyState === WebSocket.CONNECTING
      ) {
        return;
      }

      currentSocket = null;

      if (socketRef.current === socket) {
        socketRef.current = null;
      }

      clearReconnectTimer();
      connect();
    }

    function handleVisibilityChange() {
      if (!document.hidden) {
        checkConnection();
      }
    }

    document.addEventListener(
      "visibilitychange",
      handleVisibilityChange
    );

    window.addEventListener(
      "focus",
      checkConnection
    );

    window.addEventListener(
      "pageshow",
      checkConnection
    );

    window.addEventListener(
      "online",
      checkConnection
    );

    connect();

    return () => {
      disposed = true;

      document.removeEventListener(
        "visibilitychange",
        handleVisibilityChange
      );

      window.removeEventListener(
        "focus",
        checkConnection
      );

      window.removeEventListener(
        "pageshow",
        checkConnection
      );

      window.removeEventListener(
        "online",
        checkConnection
      );

      clearReconnectTimer();
      clearConnectionTimers();

      if (currentSocket) {
        currentSocket.close();
      }

      socketRef.current = null;
    };
  }, [
    activeRoomId,
    clientId,
    nickname,
    connectionVersion,
  ]);

  // ========================================
  // RESETY I PRZEWIJANIE
  // ========================================

  useEffect(() => {
    setTypingUsers([]);
    typingSentRef.current = false;

    return () => {
      if (
        typingTimerRef.current !== undefined
      ) {
        window.clearTimeout(
          typingTimerRef.current
        );

        typingTimerRef.current = undefined;
      }

      typingSentRef.current = false;
    };
  }, [activeRoomId]);

  useEffect(() => {
    if (chatScrollRef.current) {
      chatScrollRef.current.scrollTop =
        chatScrollRef.current.scrollHeight;
    }
  }, [
    activeRoomId,
    messages,
    mobileScreen,
  ]);

  // ========================================
  // WSKAŹNIK PISANIA
  // ========================================

  function stopTyping() {
    if (
      typingTimerRef.current !== undefined
    ) {
      window.clearTimeout(
        typingTimerRef.current
      );

      typingTimerRef.current = undefined;
    }

    if (!typingSentRef.current) return;

    typingSentRef.current = false;

    const socket = socketRef.current;

    if (
      socket?.readyState === WebSocket.OPEN
    ) {
      socket.send(
        JSON.stringify({
          type: "typing",
          isTyping: false,
        })
      );
    }
  }

  function handleDraftChange(value: string) {
    setDraft(value);

    if (!value.trim()) {
      stopTyping();
      return;
    }

    const socket = socketRef.current;

    if (
      socket?.readyState === WebSocket.OPEN &&
      !typingSentRef.current
    ) {
      socket.send(
        JSON.stringify({
          type: "typing",
          isTyping: true,
        })
      );

      typingSentRef.current = true;
    }

    if (
      typingTimerRef.current !== undefined
    ) {
      window.clearTimeout(
        typingTimerRef.current
      );
    }

    typingTimerRef.current = window.setTimeout(
      () => stopTyping(),
      TYPING_STOP_DELAY
    );
  }

  // ========================================
  // SZYBKIE SERDUSZKO
  // ========================================

  function addHeartToMessage(
    message: ChatMessage
  ) {
    cancelPendingImageOpen();

    setHeartBurst({
      messageId: message.id,
      sequence: Date.now(),
    });

    const alreadyLiked =
      message.reactions["❤️"]?.includes(
        clientId
      ) ?? false;

    if (alreadyLiked) return;

    if (
      heartPendingRef.current.has(
        message.id
      )
    ) {
      return;
    }

    const socket = socketRef.current;

    if (
      !socket ||
      socket.readyState !== WebSocket.OPEN ||
      socketStatus !== "online"
    ) {
      setActionError(
        "Brak połączenia z serwerem."
      );
      return;
    }

    heartPendingRef.current.add(message.id);

    try {
      socket.send(
        JSON.stringify({
          type: "toggle_reaction",
          message_id: message.id,
          emoji: "❤️",
        })
      );

      window.setTimeout(() => {
        heartPendingRef.current.delete(
          message.id
        );
      }, 2000);
    } catch (error) {
      heartPendingRef.current.delete(
        message.id
      );

      console.error(
        "[SoCalled] Szybkie serce:",
        error
      );

      setActionError(
        "Nie udało się dodać serduszka."
      );
    }
  }

  // ========================================
  // ELEMENTY INTERAKTYWNE
  // ========================================

  function isOtherInteractiveElement(
    target: EventTarget
  ): boolean {
    if (!(target instanceof Element)) {
      return false;
    }

    const control = target.closest(
      "button, input, textarea, select, a, video"
    );

    if (!control) return false;

    // Zdjęcia nadal obsługują double tap.
    // Filmy mają własne natywne sterowanie.
    return !control.classList.contains(
      "socalled-chat-image-button"
    );
  }

  // ========================================
  // KOMPUTER — DOUBLE CLICK
  // ========================================

  function handleMessageDoubleClick(
    event: ReactMouseEvent<HTMLDivElement>,
    message: ChatMessage
  ) {
    if (
      Date.now() -
      lastTouchAtRef.current < 900
    ) {
      return;
    }

    if (
      isOtherInteractiveElement(
        event.target
      )
    ) {
      return;
    }

    event.preventDefault();

    suppressImageClickRef.current = {
      messageId: message.id,
      until: Date.now() + 900,
    };

    addHeartToMessage(message);
  }

  // ========================================
  // TELEFON — TOUCH START
  // ========================================

  function handleMessageTouchStart(
    event: ReactTouchEvent<HTMLDivElement>
  ) {
    if (event.touches.length !== 1) {
      touchStartRef.current = null;
      lastTapRef.current = null;
      return;
    }

    const touch = event.touches[0];

    touchStartRef.current = {
      x: touch.clientX,
      y: touch.clientY,
    };
  }

  // ========================================
  // TELEFON — TOUCH END
  // ========================================

  function handleMessageTouchEnd(
    event: ReactTouchEvent<HTMLDivElement>,
    message: ChatMessage
  ) {
    lastTouchAtRef.current = Date.now();

    if (
      event.changedTouches.length !== 1 ||
      isOtherInteractiveElement(
        event.target
      )
    ) {
      lastTapRef.current = null;
      touchStartRef.current = null;
      return;
    }

    const touch = event.changedTouches[0];
    const start = touchStartRef.current;

    touchStartRef.current = null;

    if (!start) {
      lastTapRef.current = null;
      return;
    }

    const movementX = Math.abs(
      touch.clientX - start.x
    );

    const movementY = Math.abs(
      touch.clientY - start.y
    );

    if (
      movementX > MAX_TOUCH_MOVEMENT ||
      movementY > MAX_TOUCH_MOVEMENT
    ) {
      lastTapRef.current = null;
      return;
    }

    const now = Date.now();
    const previous = lastTapRef.current;

    const isDoubleTap =
      previous !== null &&
      previous.messageId === message.id &&
      now - previous.time <= DOUBLE_TAP_INTERVAL &&
      Math.abs(touch.clientX - previous.x) <=
        DOUBLE_TAP_DISTANCE &&
      Math.abs(touch.clientY - previous.y) <=
        DOUBLE_TAP_DISTANCE;

    if (isDoubleTap) {
      lastTapRef.current = null;

      if (event.cancelable) {
        event.preventDefault();
      }

      suppressImageClickRef.current = {
        messageId: message.id,
        until: now + 900,
      };

      cancelPendingImageOpen();
      addHeartToMessage(message);
      return;
    }

    lastTapRef.current = {
      messageId: message.id,
      time: now,
      x: touch.clientX,
      y: touch.clientY,
    };
  }

  // ========================================
  // POJEDYNCZE KLIKNIĘCIE ZDJĘCIA
  // ========================================

  function handleImageClick(
    event: ReactMouseEvent<HTMLButtonElement>,
    message: ChatMessage
  ) {
    if (!message.image) return;

    if (event.detail > 1) {
      cancelPendingImageOpen();
      return;
    }

    const suppressed =
      suppressImageClickRef.current;

    if (
      suppressed?.messageId === message.id &&
      Date.now() < suppressed.until
    ) {
      cancelPendingImageOpen();
      return;
    }

    cancelPendingImageOpen();

    imageClickTimerRef.current = window.setTimeout(
      () => {
        imageClickTimerRef.current = undefined;

        const currentSuppression =
          suppressImageClickRef.current;

        if (
          currentSuppression?.messageId === message.id &&
          Date.now() < currentSuppression.until
        ) {
          return;
        }

        setImageViewer({
          image: message.image!,
          author: message.author,
          messageId: message.id,
        });
      },
      SINGLE_IMAGE_CLICK_DELAY
    );
  }

  // ========================================
  // ZDJĘCIA — WYBÓR
  // ========================================

  async function handleMessageImageSelection(
    event: ChangeEvent<HTMLInputElement>
  ) {
    const file = event.target.files?.[0];
    event.target.value = "";

    if (!file) return;

    // Jeden załącznik na wiadomość.
    removeAttachedVideo();

    const version =
      ++imagePrepareVersionRef.current;

    setImagePreparing(true);
    setImageError("");

    try {
      const prepared =
        await prepareMessageImage(file);

      if (
        version !== imagePrepareVersionRef.current
      ) {
        return;
      }

      setAttachedImage(prepared);
    } catch (error) {
      if (
        version !== imagePrepareVersionRef.current
      ) {
        return;
      }

      setImageError(
        error instanceof Error
          ? error.message
          : "Nie udało się przygotować zdjęcia."
      );
    } finally {
      if (
        version === imagePrepareVersionRef.current
      ) {
        setImagePreparing(false);
      }
    }
  }

  function removeAttachedImage() {
    imagePrepareVersionRef.current += 1;

    setAttachedImage(null);
    setImagePreparing(false);
    setImageError("");
  }

  // ========================================
  // NOWOŚĆ — USUWANIE WYBRANEGO FILMU
  // ========================================

  function removeAttachedVideo() {
    videoUploadVersionRef.current += 1;
    videoAbortRef.current?.abort();
    videoAbortRef.current = null;

    setAttachedVideoId(null);
    setAttachedVideoName("");
    setAttachedVideoSize(0);
    setVideoUploading(false);
    setVideoError("");
  }

  // ========================================
  // NOWOŚĆ — PRZESYŁANIE FILMU HTTP
  // ========================================

  async function handleVideoSelection(
    event: ChangeEvent<HTMLInputElement>
  ) {
    const file = event.target.files?.[0];
    event.target.value = "";

    if (!file) return;

    const mimeType = videoMimeType(file);

    if (!mimeType) {
      setVideoError(
        "Wybierz film MP4, WebM lub MOV."
      );
      return;
    }

    if (file.size === 0) {
      setVideoError("Film jest pusty.");
      return;
    }

    if (file.size > MAX_VIDEO_BYTES) {
      setVideoError(
        "Film może mieć maksymalnie 40 MB."
      );
      return;
    }

    removeAttachedImage();
    removeAttachedVideo();

    const version =
      ++videoUploadVersionRef.current;

    const controller = new AbortController();
    videoAbortRef.current = controller;

    setVideoUploading(true);
    setVideoError("");

    setAttachedVideoName(file.name);
    setAttachedVideoSize(file.size);

    try {
      const response = await fetch(
        "/api/videos",
        {
          method: "POST",
          headers: {
            "Content-Type": mimeType,
          },
          body: file,
          signal: controller.signal,
        }
      );

      const result = await response.json();

      if (!response.ok) {
        throw new Error(
          typeof result.detail === "string"
            ? result.detail
            : "Nie udało się przesłać filmu."
        );
      }

      if (
        typeof result.id !== "string" ||
        !/^[a-f0-9]{32}$/.test(result.id)
      ) {
        throw new Error(
          "Serwer zwrócił nieprawidłową odpowiedź."
        );
      }

      if (
        version !== videoUploadVersionRef.current
      ) {
        return;
      }

      const uploaded =
        result as VideoUploadResponse;

      setAttachedVideoId(uploaded.id);
    } catch (error) {
      if (
        version !== videoUploadVersionRef.current
      ) {
        return;
      }

      if (
        error instanceof DOMException &&
        error.name === "AbortError"
      ) {
        return;
      }

      setAttachedVideoId(null);

      setVideoError(
        error instanceof Error
          ? error.message
          : "Nie udało się przesłać filmu."
      );
    } finally {
      if (
        version === videoUploadVersionRef.current
      ) {
        setVideoUploading(false);
        videoAbortRef.current = null;
      }
    }
  }

  // ========================================
  // ZMIANA POKOJU
  // ========================================

  function openRoom(roomId: string) {
    stopTyping();
    removeAttachedImage();
    removeAttachedVideo();
    cancelPendingImageOpen();

    lastTapRef.current = null;
    touchStartRef.current = null;
    setHeartBurst(null);

    setMobileScreen("chat");
    setDetailsTab("about");
    setDraft("");
    setReplyTarget(null);
    setReactionPickerId(null);
    setTypingUsers([]);

    setActionMenuId(null);
    setEditingId(null);
    setPendingEditId(null);
    setActionError("");
    setForwardTarget(null);
    setForwardNotice(null);

    setRooms((previous) =>
      previous.map((room) =>
        room.id === roomId
          ? {
              ...room,
              unread: 0,
            }
          : room
      )
    );

    if (roomId !== activeRoomId) {
      setSocketStatus("connecting");
      setActiveRoomId(roomId);
      return;
    }

    if (
      socketStatus !== "online" ||
      socketRef.current?.readyState !== WebSocket.OPEN
    ) {
      reconnectNow();
    }
  }

  // ========================================
  // ODPOWIADANIE NA WIADOMOŚCI
  // ========================================

  function replyToMessage(
    message: ChatMessage
  ) {
    setReplyTarget(message);
    setActionMenuId(null);
    setReactionPickerId(null);

    composerInputRef.current?.focus();
  }

  // ========================================
  // WYSYŁANIE WIADOMOŚCI
  // ========================================

  function sendMessage(
    event: FormEvent<HTMLFormElement>
  ) {
    event.preventDefault();

    const text = draft.trim();
    const socket = socketRef.current;

    if (
      !text &&
      !attachedImage &&
      !attachedVideoId
    ) {
      return;
    }

    if (
      imagePreparing ||
      videoUploading
    ) {
      return;
    }

    if (
      !socket ||
      socket.readyState !== WebSocket.OPEN ||
      socketStatus !== "online"
    ) {
      reconnectNow();
      return;
    }

    try {
      stopTyping();

      socket.send(
        JSON.stringify({
          type: "send_message",
          text,
          image: attachedImage,
          video_id: attachedVideoId,
          reply_to: replyTarget?.id ?? null,
        })
      );

      setDraft("");
      setReplyTarget(null);
      removeAttachedImage();
      removeAttachedVideo();
    } catch (error) {
      console.error(
        "[SoCalled] Wysyłanie:",
        error
      );

      setActionError(
        "Nie udało się wysłać wiadomości."
      );

      reconnectNow();
    }
  }

  // ========================================
  // REAKCJE EMOJI
  // ========================================

  function toggleReaction(
    messageId: string,
    emoji: string
  ) {
    const socket = socketRef.current;

    if (
      !socket ||
      socket.readyState !== WebSocket.OPEN ||
      socketStatus !== "online"
    ) {
      setActionError(
        "Brak połączenia z serwerem."
      );
      reconnectNow();
      return;
    }

    try {
      socket.send(
        JSON.stringify({
          type: "toggle_reaction",
          message_id: messageId,
          emoji,
        })
      );

      setReactionPickerId(null);
    } catch (error) {
      console.error(
        "[SoCalled] Reakcja:",
        error
      );

      setActionError(
        "Nie udało się dodać reakcji."
      );
    }
  }

  // ========================================
  // POBIERANIE PNG
  // ========================================

  async function saveMessageImage(
    image: string,
    messageId: string
  ) {
    try {
      await downloadImage(image, messageId);

      setActionMenuId(null);
      setActionError("");
    } catch (error) {
      console.error(
        "[SoCalled] Pobieranie zdjęcia:",
        error
      );

      setActionError(
        "Nie udało się pobrać zdjęcia jako PNG."
      );
    }
  }

  // ========================================
  // PRZEKAZYWANIE WIADOMOŚCI
  // ========================================

  function startForward(
    message: ChatMessage
  ) {
    setForwardTarget(message);

    const firstOtherRoom = rooms.find(
      (room) => room.id !== activeRoomId
    );

    setForwardRoomId(
      firstOtherRoom?.id ?? ""
    );

    setForwardError("");
    setForwardNotice(null);
    setActionMenuId(null);
    setReactionPickerId(null);
  }

  function cancelForward() {
    if (forwardBusy) return;

    setForwardTarget(null);
    setForwardRoomId("");
    setForwardError("");
  }

  function submitForward(
    event: FormEvent<HTMLFormElement>
  ) {
    event.preventDefault();

    if (
      !forwardTarget ||
      forwardBusy
    ) {
      return;
    }

    if (
      !forwardRoomId ||
      forwardRoomId === activeRoomId
    ) {
      setForwardError(
        "Wybierz inny pokój."
      );
      return;
    }

    const socket = socketRef.current;

    if (
      !socket ||
      socket.readyState !== WebSocket.OPEN ||
      socketStatus !== "online"
    ) {
      setForwardError(
        "Brak połączenia z serwerem."
      );
      return;
    }

    const requestId = makeRequestId();

    forwardRequestRef.current = requestId;
    setForwardBusy(true);
    setForwardError("");

    try {
      socket.send(
        JSON.stringify({
          type: "forward_message",
          requestId,
          message_id: forwardTarget.id,
          target_room_id: forwardRoomId,
        })
      );
    } catch (error) {
      console.error(
        "[SoCalled] Przekazywanie:",
        error
      );

      forwardRequestRef.current = null;
      setForwardBusy(false);

      setForwardError(
        "Nie udało się przekazać wiadomości."
      );
    }
  }

  // ========================================
  // EDYCJA WIADOMOŚCI
  // ========================================

  function toggleMessageMenu(
    messageId: string
  ) {
    setActionMenuId((current) =>
      current === messageId
        ? null
        : messageId
    );

    setReactionPickerId(null);
    setActionError("");
  }

  function startMessageEdit(
    message: ChatMessage
  ) {
    if (!message.mine) return;

    setEditingId(message.id);
    setEditingText(message.text);

    setActionMenuId(null);
    setActionError("");
  }

  function cancelMessageEdit() {
    if (pendingEditId) return;

    setEditingId(null);
    setEditingText("");
    setActionError("");
  }

  function saveMessageEdit(
    event: FormEvent<HTMLFormElement>
  ) {
    event.preventDefault();

    if (
      !editingId ||
      pendingEditId
    ) {
      return;
    }

    const text = editingText.trim();
    const socket = socketRef.current;

    const original = messages.find(
      (message) =>
        message.id === editingId
    );

    if (
      !original ||
      !original.mine
    ) {
      return;
    }

    if (
      (
        !text &&
        !original.image &&
        !original.videoId
      ) ||
      text.length > 2000
    ) {
      setActionError(
        "Wiadomość musi mieć treść, zdjęcie lub film."
      );
      return;
    }

    if (original.text === text) {
      cancelMessageEdit();
      return;
    }

    if (
      !socket ||
      socket.readyState !== WebSocket.OPEN ||
      socketStatus !== "online"
    ) {
      setActionError(
        "Brak połączenia z serwerem."
      );

      reconnectNow();
      return;
    }

    socket.send(
      JSON.stringify({
        type: "edit_message",
        message_id: editingId,
        text,
      })
    );

    setPendingEditId(editingId);
    setActionError("");
  }

  // ========================================
  // USUWANIE WIADOMOŚCI
  // ========================================

  function deleteMessage(
    message: ChatMessage
  ) {
    if (
      !message.mine &&
      !canModerateMessages
    ) {
      return;
    }

    setActionMenuId(null);

    const question = message.mine
      ? "Czy na pewno chcesz usunąć tę wiadomość?"
      : "Czy jako moderator chcesz usunąć tę wiadomość?";

    if (!window.confirm(question)) return;

    const socket = socketRef.current;

    if (
      !socket ||
      socket.readyState !== WebSocket.OPEN ||
      socketStatus !== "online"
    ) {
      setActionError(
        "Brak połączenia z serwerem."
      );

      reconnectNow();
      return;
    }

    socket.send(
      JSON.stringify({
        type: "delete_message",
        message_id: message.id,
      })
    );
  }

  // ========================================
  // TWORZENIE POKOJU
  // ========================================

  function createRoom(
    event: FormEvent<HTMLFormElement>
  ) {
    event.preventDefault();

    const name = newRoomName.trim();
    const socket = socketRef.current;

    if (
      !name ||
      createBusy
    ) {
      return;
    }

    if (
      !socket ||
      socket.readyState !== WebSocket.OPEN ||
      socketStatus !== "online"
    ) {
      setCreateError(
        "Najpierw połącz się z serwerem."
      );
      return;
    }

    const requestId = makeRequestId();

    createRequestRef.current = requestId;
    setCreateBusy(true);
    setCreateError("");

    try {
      socket.send(
        JSON.stringify({
          type: "create_room",
          requestId,
          name,
          isPrivate: newRoomPrivate,
        })
      );
    } catch (error) {
      console.error(
        "[SoCalled] Tworzenie pokoju:",
        error
      );

      createRequestRef.current = null;
      setCreateBusy(false);

      setCreateError(
        "Nie udało się utworzyć pokoju."
      );
    }
  }

  // ========================================
  // ZDJĘCIE GŁÓWNE POKOJU
  // ========================================

  async function handleRoomImage(
    event: ChangeEvent<HTMLInputElement>
  ) {
    const file = event.target.files?.[0];
    event.target.value = "";

    if (
      !file ||
      !canEditRoom
    ) {
      return;
    }

    setImageBusy(true);
    setRoomError("");
    setRoomSuccess("");

    try {
      const imageData =
        await prepareRoomImage(file);

      setRoomImage(imageData);
    } catch (error) {
      setRoomError(
        error instanceof Error
          ? error.message
          : "Nie udało się wczytać zdjęcia."
      );
    } finally {
      setImageBusy(false);
    }
  }

  // ========================================
  // PERSONALIZACJA POKOJU
  // ========================================

  function saveRoomSettings(
    event: FormEvent<HTMLFormElement>
  ) {
    event.preventDefault();

    if (
      !canEditRoom ||
      roomSaving ||
      imageBusy
    ) {
      return;
    }

    const name = roomName.trim();

    if (
      !name ||
      name.length > 28
    ) {
      setRoomError(
        "Nazwa musi mieć od 1 do 28 znaków."
      );
      return;
    }

    const socket = socketRef.current;

    if (
      !socket ||
      socket.readyState !== WebSocket.OPEN ||
      socketStatus !== "online"
    ) {
      setRoomError(
        "Brak połączenia z serwerem."
      );

      reconnectNow();
      return;
    }

    const requestId = makeRequestId();

    saveRequestRef.current = requestId;
    setRoomSaving(true);
    setRoomError("");
    setRoomSuccess("");

    try {
      socket.send(
        JSON.stringify({
          type: "update_room",
          requestId,
          roomId: activeRoomId,
          name,
          description: roomDescription.trim(),
          topic: roomTopic.trim(),
          icon: roomIcon,
          image: roomImage,
        })
      );
    } catch (error) {
      console.error(
        "[SoCalled] Zapis pokoju:",
        error
      );

      saveRequestRef.current = null;
      setRoomSaving(false);

      setRoomError(
        "Nie udało się zapisać zmian."
      );
    }
  }

  // ========================================
  // NICKI UCZESTNIKÓW
  // ========================================

  function startMemberEdit(
    member: RoomMember
  ) {
    if (
      member.clientId !== clientId &&
      !isRoomOwner
    ) {
      return;
    }

    setEditingMemberId(member.clientId);
    setMemberNickname(member.nickname ?? "");
    setMemberError("");
    setMemberSuccess("");
  }

  function cancelMemberEdit() {
    if (memberSaving) return;

    setEditingMemberId(null);
    setMemberNickname("");
    setMemberError("");
  }

  function saveMemberNickname(
    event: FormEvent<HTMLFormElement>
  ) {
    event.preventDefault();

    if (
      !editingMemberId ||
      memberSaving
    ) {
      return;
    }

    const value =
      memberNickname.trim();

    if (value.length > 32) {
      setMemberError(
        "Nick może mieć maksymalnie 32 znaki."
      );
      return;
    }

    const member = activeMembers.find(
      (item) =>
        item.clientId === editingMemberId
    );

    if (!member) {
      setMemberError(
        "Nie znaleziono uczestnika."
      );
      return;
    }

    if (
      member.clientId !== clientId &&
      !isRoomOwner
    ) {
      setMemberError(
        "Nie masz uprawnień do tej zmiany."
      );
      return;
    }

    if (
      (member.nickname ?? "") === value
    ) {
      cancelMemberEdit();
      return;
    }

    const socket = socketRef.current;

    if (
      !socket ||
      socket.readyState !== WebSocket.OPEN ||
      socketStatus !== "online"
    ) {
      setMemberError(
        "Brak połączenia z serwerem."
      );

      reconnectNow();
      return;
    }

    const requestId = makeRequestId();

    memberRequestRef.current = requestId;
    setMemberSaving(true);
    setMemberError("");
    setMemberSuccess("");

    try {
      socket.send(
        JSON.stringify({
          type: "set_room_nickname",
          requestId,
          targetId: editingMemberId,
          nickname: value,
        })
      );
    } catch (error) {
      console.error(
        "[SoCalled] Zmiana nicku:",
        error
      );

      memberRequestRef.current = null;
      setMemberSaving(false);

      setMemberError(
        "Nie udało się zmienić nicku."
      );
    }
  }

  // ========================================
  // ROLE UCZESTNIKÓW
  // ========================================

  function changeMemberRole(
    member: RoomMember
  ) {
    if (
      !isRoomOwner ||
      member.role === "owner" ||
      memberSaving
    ) {
      return;
    }

    const nextRole: MemberRole =
      member.role === "moderator"
        ? "member"
        : "moderator";

    const socket = socketRef.current;

    if (
      !socket ||
      socket.readyState !== WebSocket.OPEN ||
      socketStatus !== "online"
    ) {
      setMemberError(
        "Brak połączenia z serwerem."
      );

      reconnectNow();
      return;
    }

    const requestId = makeRequestId();

    memberRequestRef.current = requestId;
    setMemberSaving(true);
    setMemberError("");
    setMemberSuccess("");

    try {
      socket.send(
        JSON.stringify({
          type: "set_member_role",
          requestId,
          targetId: member.clientId,
          role: nextRole,
        })
      );
    } catch (error) {
      console.error(
        "[SoCalled] Zmiana roli:",
        error
      );

      memberRequestRef.current = null;
      setMemberSaving(false);

      setMemberError(
        "Nie udało się zmienić roli."
      );
    }
  }

  // ========================================
  // INTERFEJS SOCALLED
  // ========================================

  return (
    <div
      className={`app-shell mobile-${mobileScreen}`}
      style={{
        "--accent": theme.hex,
        "--accent-rgb": theme.rgb,
      } as CSSProperties}
    >
      {/* ====================================
          DESKTOP — LEWY PANEL
          ==================================== */}

      <aside className="desktop-sidebar">
        <div className="sidebar-brand">
          <div className="brand-symbol">
            SO
          </div>

          <div>
            <div className="brand-name">
              So<span>Called</span>
            </div>

            <div className="brand-subtitle">
              YOUR SPACE. YOUR VOICE.
            </div>
          </div>
        </div>

        <div className="sidebar-section-title">
          <div>
            <span className="eyebrow">
              TWOJA PRZESTRZEŃ
            </span>

            <h2>Pokoje</h2>
          </div>

          <button
            className="icon-button"
            type="button"
            onClick={() => {
              setCreateError("");
              setCreateOpen(true);
            }}
            aria-label="Utwórz pokój"
            title="Utwórz pokój"
          >
            <Plus size={19} />
          </button>
        </div>

        <div className="hex-scroll">
          <div className="hex-grid">
            {rooms.map((room) => (
              <div
                key={room.id}
                className={`hex-slot ${
                  activeRoomId === room.id
                    ? "hex-slot--active"
                    : ""
                }`}
              >
                <button
                  className="hex-button"
                  type="button"
                  onClick={() =>
                    openRoom(room.id)
                  }
                  aria-label={
                    `Otwórz pokój ${room.name}`
                  }
                  aria-pressed={
                    activeRoomId === room.id
                  }
                >
                  <span className="hex-inside">
                    <RoomVisual room={room} />
                  </span>
                </button>

                {room.unread > 0 && (
                  <span className="socalled-hex-unread">
                    {room.unread > 9
                      ? "9+"
                      : room.unread}
                  </span>
                )}

                <span className="hex-tooltip">
                  {room.name}
                </span>
              </div>
            ))}
          </div>
        </div>

        <div className="sidebar-footer">
          <div className="community-status">
            <span
              className="status-dot"
              style={{
                background:
                  socketStatus === "online"
                    ? undefined
                    : "#d68c72",
              }}
            />

            <span>
              {socketStatus === "online"
                ? "SoCalled jest online"
                : "Przywracanie połączenia..."}
            </span>
          </div>

          <div className="account-card">
            <div className="account-avatar">
              {nickname
                .slice(0, 1)
                .toUpperCase()}
            </div>

            <div className="account-copy">
              <strong>{nickname}</strong>

              <span>
                {roleLabel(myRole)} w pokoju
              </span>
            </div>

            <Sparkles
              size={17}
              className="account-sparkle"
            />
          </div>
        </div>
      </aside>

      {/* ====================================
          MOBILE — LISTA POKOJÓW
          ==================================== */}

      <section className="mobile-room-screen">
        <header className="mobile-home-header">
          <div className="mobile-brand">
            <div className="brand-symbol">
              SO
            </div>

            <div className="brand-name">
              So<span>Called</span>
            </div>
          </div>

          <button
            type="button"
            className="icon-button icon-button--accent"
            onClick={() => {
              setCreateError("");
              setCreateOpen(true);
            }}
            aria-label="Utwórz pokój"
          >
            <Plus size={21} />
          </button>
        </header>

        <div className="mobile-welcome">
          <span className="eyebrow">
            WITAJ W SOCALLED
          </span>

          <h1>
            Twoje pokoje
            <span className="accent-dot">
              .
            </span>
          </h1>

          <p>
            Znajdź swoją społeczność
            i zacznij rozmawiać.
          </p>
        </div>

        <label className="mobile-search">
          <Search size={19} />

          <input
            value={search}
            onChange={(event) =>
              setSearch(
                event.target.value
              )
            }
            placeholder="Szukaj pokoju..."
            aria-label="Szukaj pokoju"
          />
        </label>

        <div className="mobile-list-heading">
          <span>
            WSZYSTKIE POKOJE
          </span>

          <span>
            {filteredRooms.length}
          </span>
        </div>

        <div className="mobile-room-list">
          {filteredRooms.map((room) => (
            <button
              key={room.id}
              className="mobile-room-item"
              type="button"
              onClick={() =>
                openRoom(room.id)
              }
            >
              <div className="mobile-room-icon">
                <RoomVisual room={room} />
              </div>

              <div className="mobile-room-copy">
                <div className="mobile-room-line">
                  <strong>
                    {room.name}
                  </strong>

                  <time>
                    {room.lastTime}
                  </time>
                </div>

                <div className="mobile-room-line">
                  <span className="mobile-preview">
                    {room.lastMessage}
                  </span>

                  {room.unread > 0 ? (
                    <span className="unread-badge">
                      {room.unread}
                    </span>
                  ) : (
                    <ChevronRight
                      size={17}
                      className="row-chevron"
                    />
                  )}
                </div>
              </div>
            </button>
          ))}

          {filteredRooms.length === 0 && (
            <p className="empty-search">
              Nie znaleziono takiego pokoju.
            </p>
          )}
        </div>

        <nav
          className="mobile-bottom-nav"
          aria-label="Nawigacja"
        >
          <button
            type="button"
            className="mobile-nav-active"
          >
            <MessageCircle size={22} />
            <span>Pokoje</span>
          </button>

          <button
            type="button"
            onClick={() => {
              setCreateError("");
              setCreateOpen(true);
            }}
          >
            <Plus size={22} />
            <span>Utwórz</span>
          </button>
        </nav>
      </section>

      {/* ====================================
          GŁÓWNY CZAT
          ==================================== */}

      <main className="chat-panel">
        <header className="chat-header">
          <button
            type="button"
            className="icon-button mobile-only"
            onClick={() => {
              stopTyping();
              setMobileScreen("rooms");
            }}
            aria-label="Powrót do pokojów"
          >
            <ArrowLeft size={22} />
          </button>

          <div className="chat-header-icon">
            <RoomVisual room={activeRoom} />
          </div>

          <div className="chat-header-copy">
            <h1>
              {activeRoom.name}
            </h1>

            <span>
              {activeRoom.topic}
            </span>
          </div>

          <div className="chat-header-actions">
            <span className="online-indicator">
              <span
                className="status-dot"
                style={{
                  background:
                    socketStatus === "online"
                      ? undefined
                      : "#d68c72",
                }}
              />

              {socketStatus === "online"
                ? "Połączono"
                : socketStatus === "connecting"
                  ? "Łączenie..."
                  : "Offline"}
            </span>

            <button
              type="button"
              className="icon-button"
              aria-label="Informacje o pokoju"
              onClick={() => {
                setDetailsTab("about");
                setMobileScreen("details");
              }}
            >
              <Info size={21} />
            </button>

            <button
              type="button"
              className="icon-button"
              aria-label="Ustawienia pokoju"
              onClick={() => {
                setDetailsTab("settings");
                setMobileScreen("details");
              }}
            >
              <Settings2 size={20} />
            </button>
          </div>
        </header>

        {/* STATUS POŁĄCZENIA */}

        {socketStatus !== "online" && (
          <div
            className="connection-warning"
            role="status"
          >
            <WifiOff size={16} />

            <span>
              {socketStatus === "connecting"
                ? "Łączenie z serwerem..."
                : "Połączenie przerwane. Ponawiam próbę..."}
            </span>

            <button
              type="button"
              onClick={reconnectNow}
            >
              <RefreshCw size={14} />
              Połącz ponownie
            </button>
          </div>
        )}

        {/* HISTORIA WIADOMOŚCI */}

        <div
          className="chat-scroll"
          ref={chatScrollRef}
        >
          <div className="chat-intro">
            <div className="chat-intro-icon">
              <RoomVisual room={activeRoom} />
            </div>

            <span className="eyebrow">
              POKÓJ SOCALLED
            </span>

            <h2>
              Witaj w {activeRoom.name}.
            </h2>

            <p>
              {activeRoom.description}
            </p>
          </div>

          <div className="date-divider">
            <span />
            <p>Historia rozmowy</p>
            <span />
          </div>

          <div className="message-list">
            {roomMessages.length === 0 ? (
              <div className="empty-messages">
                <MessageCircle size={29} />

                <h3>
                  Jeszcze tu cicho.
                </h3>

                <p>
                  Napisz pierwszą wiadomość
                  albo prześlij zdjęcie lub film.
                </p>
              </div>
            ) : (
              roomMessages.map((message) => {
                const canDelete =
                  message.mine ||
                  canModerateMessages;

                const reactionEntries =
                  Object.entries(
                    message.reactions ?? {}
                  ).filter(
                    ([, users]) =>
                      users.length > 0
                  );

                return (
                  <article
                    key={message.id}
                    className={`message-row ${
                      message.mine
                        ? "message-row--mine"
                        : ""
                    }`}
                  >
                    {!message.mine && (
                      <div className="message-avatar">
                        {message.author
                          .slice(0, 1)
                          .toUpperCase()}
                      </div>
                    )}

                    <div
                      className="message-body socalled-double-like-area"
                      onDoubleClick={(event) =>
                        handleMessageDoubleClick(
                          event,
                          message
                        )
                      }
                      onTouchStart={
                        handleMessageTouchStart
                      }
                      onTouchEnd={(event) =>
                        handleMessageTouchEnd(
                          event,
                          message
                        )
                      }
                    >
                      {/* NAGŁÓWEK WIADOMOŚCI */}

                      <div className="message-meta">
                        <strong>
                          {message.author}
                        </strong>

                        <time>
                          {message.time}
                        </time>

                        {message.editedAt && (
                          <span className="message-edited">
                            · edytowano
                          </span>
                        )}

                        {/* MENU WIADOMOŚCI */}

                        <div className="message-actions">
                          <button
                            type="button"
                            className="message-actions-trigger"
                            aria-label="Opcje wiadomości"
                            aria-expanded={
                              actionMenuId === message.id
                            }
                            onClick={() =>
                              toggleMessageMenu(
                                message.id
                              )
                            }
                          >
                            <MoreHorizontal size={19} />
                          </button>

                          {actionMenuId === message.id && (
                            <div className="message-actions-menu">
                              <button
                                type="button"
                                onClick={() =>
                                  replyToMessage(message)
                                }
                              >
                                <CornerUpLeft size={16} />
                                Odpowiedz
                              </button>

                              <button
                                type="button"
                                onClick={() =>
                                  startForward(message)
                                }
                              >
                                <Forward size={16} />
                                Przekaż dalej
                              </button>

                              {message.image && (
                                <button
                                  type="button"
                                  onClick={() =>
                                    void saveMessageImage(
                                      message.image!,
                                      message.id
                                    )
                                  }
                                >
                                  <Download size={16} />
                                  Pobierz PNG
                                </button>
                              )}

                              {message.mine && (
                                <button
                                  type="button"
                                  onClick={() =>
                                    startMessageEdit(message)
                                  }
                                >
                                  <Pencil size={16} />

                                  {message.image ||
                                  message.videoId
                                    ? "Edytuj podpis"
                                    : "Edytuj"}
                                </button>
                              )}

                              {canDelete && (
                                <button
                                  type="button"
                                  className="delete-action"
                                  onClick={() =>
                                    deleteMessage(message)
                                  }
                                >
                                  <Trash2 size={16} />

                                  {message.mine
                                    ? "Usuń"
                                    : "Usuń (moderacja)"}
                                </button>
                              )}
                            </div>
                          )}
                        </div>
                      </div>

                      {/* PRZEKAZANA WIADOMOŚĆ */}

                      {message.forwardedFrom && (
                        <div className="socalled-forwarded-origin">
                          <Forward size={14} />

                          <div>
                            <span>
                              Przekazano z{" "}
                              <strong>
                                {message.forwardedFrom.roomName}
                              </strong>
                            </span>

                            <small>
                              Oryginalny autor:{" "}
                              {message.forwardedFrom.author}
                            </small>
                          </div>
                        </div>
                      )}

                      {/* CYTAT */}

                      {message.replyTo && (
                        <div className="socalled-reply-quote">
                          <CornerUpLeft size={14} />

                          <div className="socalled-reply-quote-copy">
                            <strong>
                              {message.replyTo.deleted
                                ? "Usunięta wiadomość"
                                : message.replyTo.author}
                            </strong>

                            <span>
                              {message.replyTo.text}
                            </span>
                          </div>
                        </div>
                      )}

                      {/* ZDJĘCIE */}

                      {message.image && (
                        <button
                          type="button"
                          className="socalled-chat-image-button"
                          onClick={(event) =>
                            handleImageClick(
                              event,
                              message
                            )
                          }
                          aria-label={
                            `Otwórz zdjęcie od ${message.author}`
                          }
                        >
                          <img
                            src={message.image}
                            alt={
                              `Zdjęcie wysłane przez ${message.author}`
                            }
                            loading="lazy"
                          />

                          <span className="socalled-image-zoom">
                            <Search size={15} />
                            Powiększ
                          </span>
                        </button>
                      )}

                      {/* NOWOŚĆ — ODTWARZACZ FILMU */}

                      {message.videoId && (
                        <div className="socalled-chat-video-wrap">
                          <div className="socalled-chat-video-label">
                            <Clapperboard size={15} />
                            Film w wiadomości
                          </div>

                          <video
                            key={message.videoId}
                            className="socalled-chat-video"
                            src={videoUrl(
                              message.videoId
                            )}
                            controls
                            playsInline
                            preload="metadata"
                            onDoubleClick={(event) =>
                              event.stopPropagation()
                            }
                          >
                            Twoja przeglądarka
                            nie obsługuje odtwarzania
                            tego filmu.
                          </video>
                        </div>
                      )}

                      {/* TEKST / EDYCJA PODPISU */}

                      {editingId === message.id ? (
                        <form
                          className="message-edit-form"
                          onSubmit={saveMessageEdit}
                        >
                          <textarea
                            value={editingText}
                            onChange={(event) =>
                              setEditingText(
                                event.target.value
                              )
                            }
                            maxLength={2000}
                            rows={3}
                            placeholder={
                              message.image ||
                              message.videoId
                                ? "Podpis (opcjonalny)"
                                : "Treść wiadomości"
                            }
                            aria-label="Edytuj wiadomość"
                            autoFocus
                            disabled={
                              pendingEditId === message.id
                            }
                          />

                          <div className="message-edit-controls">
                            <button
                              type="button"
                              className="edit-cancel"
                              onClick={
                                cancelMessageEdit
                              }
                              disabled={
                                pendingEditId === message.id
                              }
                            >
                              <X size={15} />
                              Anuluj
                            </button>

                            <button
                              type="submit"
                              className="edit-save"
                              disabled={
                                (
                                  !editingText.trim() &&
                                  !message.image &&
                                  !message.videoId
                                ) ||
                                pendingEditId === message.id ||
                                socketStatus !== "online"
                              }
                            >
                              <Check size={15} />

                              {pendingEditId === message.id
                                ? "Zapisywanie..."
                                : "Zapisz"}
                            </button>
                          </div>
                        </form>
                      ) : (
                        message.text && (
                          <div className="message-bubble">
                            {message.text}
                          </div>
                        )
                      )}

                      {/* REAKCJE EMOJI */}

                      <div className="socalled-message-social">
                        {reactionEntries.map(
                          ([emoji, users]) => {
                            const mine =
                              users.includes(clientId);

                            return (
                              <button
                                type="button"
                                key={emoji}
                                className={`socalled-reaction-chip ${
                                  mine
                                    ? "socalled-reaction-mine"
                                    : ""
                                }`}
                                onClick={() =>
                                  toggleReaction(
                                    message.id,
                                    emoji
                                  )
                                }
                                disabled={
                                  socketStatus !== "online"
                                }
                                aria-pressed={mine}
                                aria-label={
                                  `${emoji}: ${users.length} reakcji`
                                }
                              >
                                <span>{emoji}</span>

                                <strong>
                                  {users.length}
                                </strong>
                              </button>
                            );
                          }
                        )}

                        <button
                          type="button"
                          className="socalled-reaction-add"
                          aria-label="Dodaj reakcję"
                          aria-expanded={
                            reactionPickerId === message.id
                          }
                          disabled={
                            socketStatus !== "online"
                          }
                          onClick={() => {
                            setActionMenuId(null);

                            setReactionPickerId(
                              (current) =>
                                current === message.id
                                  ? null
                                  : message.id
                            );
                          }}
                        >
                          <SmilePlus size={16} />
                        </button>
                      </div>

                      {reactionPickerId === message.id && (
                        <div className="socalled-reaction-picker">
                          {availableReactions.map((emoji) => (
                            <button
                              type="button"
                              key={emoji}
                              onClick={() =>
                                toggleReaction(
                                  message.id,
                                  emoji
                                )
                              }
                              aria-label={
                                `Reakcja ${emoji}`
                              }
                            >
                              {emoji}
                            </button>
                          ))}
                        </div>
                      )}

                      {/* SERDUSZKO DOUBLE TAP */}

                      {heartBurst?.messageId === message.id && (
                        <span
                          key={heartBurst.sequence}
                          className="socalled-double-heart"
                          aria-hidden="true"
                        >
                          <Heart
                            size={76}
                            fill="currentColor"
                            strokeWidth={1}
                          />
                        </span>
                      )}
                    </div>
                  </article>
                );
              })
            )}
          </div>
        </div>

        {/* BŁĘDY OPERACJI */}

        {actionError && (
          <div
            className="message-operation-error"
            role="alert"
          >
            <span>
              {actionError}
            </span>

            <button
              type="button"
              onClick={() =>
                setActionError("")
              }
              aria-label="Zamknij komunikat"
            >
              <X size={17} />
            </button>
          </div>
        )}

        {/* POTWIERDZENIE PRZEKAZANIA */}

        {forwardNotice && (
          <div
            className="socalled-forward-notice"
            role="status"
          >
            <Check size={17} />

            <span>
              Przekazano do{" "}
              <strong>
                {forwardNotice.roomName}
              </strong>
            </span>

            <button
              type="button"
              onClick={() => {
                const roomId =
                  forwardNotice.roomId;

                setForwardNotice(null);
                openRoom(roomId);
              }}
            >
              Otwórz pokój
            </button>

            <button
              type="button"
              className="socalled-notice-close"
              aria-label="Zamknij powiadomienie"
              onClick={() =>
                setForwardNotice(null)
              }
            >
              <X size={16} />
            </button>
          </div>
        )}

        {/* WSKAŹNIK PISANIA */}

        {socketStatus === "online" &&
          typingLabel && (
          <div
            className="socalled-typing-indicator"
            role="status"
            aria-live="polite"
          >
            <span className="socalled-typing-dots">
              <i />
              <i />
              <i />
            </span>

            <span>
              {typingLabel}
            </span>
          </div>
        )}

        {/* ODPOWIEDŹ */}

        {replyTarget && (
          <div className="socalled-reply-composer">
            <CornerUpLeft size={17} />

            <div>
              <strong>
                Odpowiadasz: {replyTarget.author}
              </strong>

              <span>
                {replyTarget.videoId
                  ? "🎬 Film"
                  : replyTarget.image
                    ? "📷 Zdjęcie"
                    : replyTarget.text.slice(0, 140)}
              </span>
            </div>

            <button
              type="button"
              onClick={() =>
                setReplyTarget(null)
              }
              aria-label="Anuluj odpowiedź"
            >
              <X size={19} />
            </button>
          </div>
        )}

        {/* PODGLĄD ZDJĘCIA PRZED WYSŁANIEM */}

        {attachedImage && (
          <div className="socalled-image-attachment">
            <div className="socalled-attachment-thumbnail">
              <img
                src={attachedImage}
                alt="Zdjęcie przygotowane do wysłania"
              />
            </div>

            <div className="socalled-attachment-info">
              <strong>
                Zdjęcie gotowe do wysłania
              </strong>

              <span>
                Możesz dodać podpis lub wysłać
                samo zdjęcie.
              </span>
            </div>

            <button
              type="button"
              className="socalled-attachment-remove"
              onClick={
                removeAttachedImage
              }
              aria-label="Usuń załączone zdjęcie"
            >
              <X size={18} />
            </button>
          </div>
        )}

        {imagePreparing && (
          <div
            className="socalled-image-processing"
            role="status"
          >
            <ImagePlus size={17} />
            Przygotowywanie zdjęcia...
          </div>
        )}

        {imageError && (
          <div
            className="socalled-image-error"
            role="alert"
          >
            <span>
              {imageError}
            </span>

            <button
              type="button"
              onClick={() =>
                setImageError("")
              }
              aria-label="Zamknij błąd"
            >
              <X size={16} />
            </button>
          </div>
        )}

        {/* NOWOŚĆ — PRZESYŁANIE FILMU */}

        {videoUploading && (
          <div
            className="socalled-video-uploading"
            role="status"
          >
            <Clapperboard size={19} />

            <div>
              <strong>
                Przesyłanie filmu...
              </strong>

              <span>
                {attachedVideoName}
                {" · "}
                {formatFileSize(
                  attachedVideoSize
                )}
              </span>
            </div>

            <button
              type="button"
              onClick={
                removeAttachedVideo
              }
              aria-label="Anuluj przesyłanie filmu"
            >
              <X size={18} />
            </button>
          </div>
        )}

        {/* NOWOŚĆ — PODGLĄD FILMU */}

        {attachedVideoId &&
          !videoUploading && (
          <div className="socalled-video-attachment">
            <div className="socalled-video-attachment-heading">
              <Film size={19} />

              <div>
                <strong>
                  Film gotowy do wysłania
                </strong>

                <span>
                  {attachedVideoName}
                  {" · "}
                  {formatFileSize(
                    attachedVideoSize
                  )}
                </span>
              </div>

              <button
                type="button"
                onClick={
                  removeAttachedVideo
                }
                aria-label="Usuń załączony film"
              >
                <X size={18} />
              </button>
            </div>

            <video
              className="socalled-video-attachment-preview"
              src={videoUrl(
                attachedVideoId
              )}
              controls
              playsInline
              preload="metadata"
            />

            <p>
              Możesz dopisać tekst pod filmem
              albo wysłać go bez podpisu.
            </p>
          </div>
        )}

        {videoError && (
          <div
            className="socalled-video-error"
            role="alert"
          >
            <span>
              {videoError}
            </span>

            <button
              type="button"
              onClick={() =>
                setVideoError("")
              }
              aria-label="Zamknij błąd filmu"
            >
              <X size={16} />
            </button>
          </div>
        )}

        {/* KOMPOZYTOR WIADOMOŚCI */}

        <div className="composer-area">
          <form
            className="message-composer"
            onSubmit={sendMessage}
          >
            {/* INPUT ZDJĘĆ */}

            <input
              ref={fileInputRef}
              type="file"
              accept="image/png,image/jpeg,image/webp"
              className="socalled-hidden-file-input"
              onChange={
                handleMessageImageSelection
              }
              aria-label="Wybierz zdjęcie"
            />

            {/* NOWOŚĆ — INPUT FILMÓW */}

            <input
              ref={videoInputRef}
              type="file"
              accept="video/mp4,video/webm,video/quicktime,.mp4,.webm,.mov"
              className="socalled-hidden-file-input"
              onChange={
                handleVideoSelection
              }
              aria-label="Wybierz film"
            />

            <button
              type="button"
              className="socalled-composer-attach"
              onClick={() =>
                fileInputRef.current?.click()
              }
              disabled={
                socketStatus !== "online" ||
                imagePreparing ||
                videoUploading
              }
              aria-label="Dodaj zdjęcie"
              title="Dodaj zdjęcie"
            >
              <ImagePlus size={20} />
            </button>

            {/* NOWOŚĆ — PRZYCISK FILMU */}

            <button
              type="button"
              className="socalled-composer-attach socalled-video-attach"
              onClick={() =>
                videoInputRef.current?.click()
              }
              disabled={
                socketStatus !== "online" ||
                imagePreparing ||
                videoUploading
              }
              aria-label="Dodaj film"
              title="Dodaj film"
            >
              <Clapperboard size={20} />
            </button>

            <input
              ref={composerInputRef}
              value={draft}
              onChange={(event) =>
                handleDraftChange(
                  event.target.value
                )
              }
              placeholder={
                socketStatus === "online"
                  ? attachedVideoId
                    ? "Dodaj podpis do filmu..."
                    : attachedImage
                      ? "Dodaj podpis do zdjęcia..."
                      : `Wiadomość do ${activeRoom.name}...`
                  : "Oczekiwanie na połączenie..."
              }
              aria-label="Treść wiadomości"
              maxLength={2000}
            />

            <button
              type="submit"
              className="send-button"
              disabled={
                (
                  !draft.trim() &&
                  !attachedImage &&
                  !attachedVideoId
                ) ||
                imagePreparing ||
                videoUploading ||
                socketStatus !== "online"
              }
              aria-label="Wyślij wiadomość"
            >
              <Send size={20} />
            </button>
          </form>

          <p className="composer-hint">
            {socketStatus === "online"
              ? "Połączono — tekst, zdjęcia i filmy na żywo."
              : "Przywracanie połączenia z serwerem..."}
          </p>
        </div>
      </main>

      {/* ====================================
          PRAWY PANEL
          ==================================== */}

      <aside className="details-panel">
        <header className="details-header">
          <div>
            <span className="eyebrow">
              TWOJA SPOŁECZNOŚĆ
            </span>

            <h2>
              Informacje
            </h2>
          </div>

          <button
            type="button"
            className="icon-button mobile-only"
            onClick={() =>
              setMobileScreen("chat")
            }
            aria-label="Wróć do czatu"
          >
            <X size={22} />
          </button>
        </header>

        <div className="details-scroll">
          <div className="room-identity">
            <div className="room-identity-icon">
              <RoomVisual room={activeRoom} />
            </div>

            <h3>
              {activeRoom.name}
            </h3>

            <p>
              {activeRoom.topic}
            </p>

            <span className="room-type-pill">
              {activeRoom.isPrivate ? (
                <LockKeyhole size={13} />
              ) : (
                <Globe2 size={13} />
              )}

              {activeRoom.isPrivate
                ? "Pokój prywatny (demo)"
                : "Pokój publiczny"}
            </span>
          </div>

          {/* ZAKŁADKI */}

          <div className="details-tabs">
            <button
              type="button"
              className={
                detailsTab === "about"
                  ? "tab-active"
                  : ""
              }
              onClick={() =>
                setDetailsTab("about")
              }
            >
              O pokoju
            </button>

            <button
              type="button"
              className={
                detailsTab === "settings"
                  ? "tab-active"
                  : ""
              }
              onClick={() =>
                setDetailsTab("settings")
              }
            >
              Ustawienia
            </button>
          </div>

          {/* O POKOJU */}

          {detailsTab === "about" ? (
            <div className="details-content">
              <div className="details-section">
                <h4>
                  OPIS POKOJU
                </h4>

                <p>
                  {activeRoom.description}
                </p>
              </div>

              <div className="room-stats">
                <div>
                  <Users size={19} />

                  <strong>
                    {activeRoom.memberCount}
                  </strong>

                  <span>
                    Uczestników
                  </span>
                </div>

                <div>
                  <span className="status-dot" />

                  <strong>
                    {activeRoom.onlineCount}
                  </strong>

                  <span>
                    Online
                  </span>
                </div>
              </div>

              {/* TWOJA ROLA */}

              <div className="details-section">
                <h4>
                  TWOJA ROLA
                </h4>

                <div className="socalled-my-role">
                  <RoleIcon role={myRole} />

                  <strong>
                    {roleLabel(myRole)}
                  </strong>
                </div>

                <p>
                  {myRole === "owner"
                    ? "Zarządzasz pokojem, moderatorami i nickami uczestników."
                    : myRole === "moderator"
                      ? "Możesz moderować wiadomości oraz zmieniać swój nick."
                      : "Możesz wysyłać wiadomości, zdjęcia i filmy oraz reagować na wpisy."}
                </p>
              </div>

              {/* UCZESTNICY */}

              <div className="details-section">
                <div className="section-heading-row">
                  <h4>
                    UCZESTNICY POKOJU
                  </h4>
                </div>

                {activeMembers.length === 0 ? (
                  <p className="socalled-members-empty">
                    Oczekiwanie na listę uczestników...
                  </p>
                ) : (
                  <div className="socalled-members-list">
                    {activeMembers.map((member) => {
                      const canEditNickname =
                        member.clientId === clientId ||
                        isRoomOwner;

                      const canChangeRole =
                        isRoomOwner &&
                        member.role !== "owner";

                      return (
                        <div
                          className="socalled-member-entry"
                          key={member.clientId}
                        >
                          <div className="socalled-member-main">
                            <div className="socalled-member-avatar">
                              {member.displayName
                                .slice(0, 1)
                                .toUpperCase()}
                            </div>

                            <div className="socalled-member-info">
                              <strong>
                                {member.displayName}

                                {member.clientId === clientId && (
                                  <span className="socalled-you-label">
                                    {" "}(Ty)
                                  </span>
                                )}
                              </strong>

                              {member.nickname && (
                                <span className="socalled-member-username">
                                  @{member.username}
                                </span>
                              )}

                              <div className="socalled-member-status">
                                <span
                                  className={
                                    member.online
                                      ? "socalled-presence online"
                                      : "socalled-presence offline"
                                  }
                                />

                                <span>
                                  {member.online
                                    ? "Online"
                                    : "Offline"}
                                </span>
                              </div>

                              <span
                                className={`socalled-role-badge role-${member.role}`}
                              >
                                <RoleIcon
                                  role={member.role}
                                />

                                {roleLabel(member.role)}
                              </span>
                            </div>

                            {canEditNickname && (
                              <button
                                type="button"
                                className="socalled-member-edit-button"
                                aria-label={
                                  `Edytuj nick ${member.displayName}`
                                }
                                onClick={() =>
                                  startMemberEdit(member)
                                }
                                disabled={memberSaving}
                              >
                                <Pencil size={16} />
                              </button>
                            )}
                          </div>

                          {/* EDYCJA NICKU */}

                          {editingMemberId === member.clientId && (
                            <form
                              className="socalled-nickname-form"
                              onSubmit={saveMemberNickname}
                            >
                              <label>
                                Nick w tym pokoju
                              </label>

                              <input
                                value={memberNickname}
                                onChange={(event) =>
                                  setMemberNickname(
                                    event.target.value
                                  )
                                }
                                maxLength={32}
                                placeholder={member.username}
                                disabled={memberSaving}
                                autoFocus
                              />

                              <small>
                                Puste pole przywraca
                                podstawową nazwę.
                              </small>

                              <div className="socalled-nickname-actions">
                                <button
                                  type="button"
                                  onClick={cancelMemberEdit}
                                  disabled={memberSaving}
                                >
                                  Anuluj
                                </button>

                                <button
                                  type="submit"
                                  className="socalled-nickname-save"
                                  disabled={
                                    memberSaving ||
                                    socketStatus !== "online"
                                  }
                                >
                                  <Check size={15} />

                                  {memberSaving
                                    ? "Zapisywanie..."
                                    : "Zapisz"}
                                </button>
                              </div>
                            </form>
                          )}

                          {canChangeRole && (
                            <button
                              type="button"
                              className="socalled-role-control"
                              onClick={() =>
                                changeMemberRole(member)
                              }
                              disabled={
                                memberSaving ||
                                socketStatus !== "online"
                              }
                            >
                              <ShieldCheck size={15} />

                              {member.role === "moderator"
                                ? "Odbierz moderatora"
                                : "Nadaj moderatora"}
                            </button>
                          )}
                        </div>
                      );
                    })}
                  </div>
                )}

                {memberError && (
                  <div
                    className="room-form-error"
                    role="alert"
                  >
                    {memberError}
                  </div>
                )}

                {memberSuccess && (
                  <div
                    className="room-form-success"
                    role="status"
                  >
                    <Check size={16} />
                    {memberSuccess}
                  </div>
                )}
              </div>

              <div className="details-notice">
                <ShieldCheck size={20} />

                <p>
                  Uczestnicy, wiadomości, zdjęcia
                  i reakcje synchronizują się
                  w czasie rzeczywistym.
                </p>
              </div>
            </div>
          ) : (
            /* USTAWIENIA */

            <div className="details-content">
              <div className="details-section">
                <h4>
                  <Settings2 size={16} />
                  PERSONALIZACJA POKOJU
                </h4>

                <p>
                  Dostosuj nazwę, opis,
                  ikonę i zdjęcie pokoju.
                </p>

                {!canEditRoom && (
                  <div className="room-editor-locked">
                    <LockKeyhole size={18} />

                    Tylko właściciel może
                    zmieniać ustawienia pokoju.
                  </div>
                )}

                <form
                  className="room-custom-form"
                  onSubmit={saveRoomSettings}
                >
                  <label htmlFor="custom-room-name">
                    Nazwa pokoju
                  </label>

                  <input
                    id="custom-room-name"
                    value={roomName}
                    onChange={(event) =>
                      setRoomName(
                        event.target.value
                      )
                    }
                    maxLength={28}
                    required
                    disabled={
                      !canEditRoom ||
                      roomSaving
                    }
                  />

                  <label htmlFor="custom-room-topic">
                    Temat pokoju
                  </label>

                  <input
                    id="custom-room-topic"
                    value={roomTopic}
                    onChange={(event) =>
                      setRoomTopic(
                        event.target.value
                      )
                    }
                    maxLength={100}
                    placeholder="O czym rozmawiamy?"
                    disabled={
                      !canEditRoom ||
                      roomSaving
                    }
                  />

                  <label htmlFor="custom-room-description">
                    Opis pokoju
                  </label>

                  <textarea
                    id="custom-room-description"
                    value={roomDescription}
                    onChange={(event) =>
                      setRoomDescription(
                        event.target.value
                      )
                    }
                    maxLength={300}
                    rows={3}
                    placeholder="Opisz społeczność..."
                    disabled={
                      !canEditRoom ||
                      roomSaving
                    }
                  />

                  <span className="room-custom-label">
                    Ikona pokoju
                  </span>

                  <div className="room-icon-picker">
                    {availableIcons.map((icon) => (
                      <button
                        type="button"
                        key={icon}
                        className={
                          roomIcon === icon
                            ? "room-icon-option selected"
                            : "room-icon-option"
                        }
                        onClick={() =>
                          setRoomIcon(icon)
                        }
                        aria-label={`Wybierz ikonę ${icon}`}
                        aria-pressed={
                          roomIcon === icon
                        }
                        disabled={
                          !canEditRoom ||
                          roomSaving
                        }
                      >
                        <RoomGlyph icon={icon} />
                      </button>
                    ))}
                  </div>

                  <span className="room-custom-label">
                    Zdjęcie główne
                  </span>

                  <div className="room-image-editor">
                    <div className="room-image-preview">
                      {roomImage ? (
                        <img
                          src={roomImage}
                          alt="Podgląd zdjęcia pokoju"
                        />
                      ) : (
                        <RoomGlyph icon={roomIcon} />
                      )}
                    </div>

                    <div className="room-image-actions">
                      <label
                        className={`room-upload-button ${
                          !canEditRoom ||
                          roomSaving ||
                          imageBusy
                            ? "room-upload-disabled"
                            : ""
                        }`}
                      >
                        <ImagePlus size={16} />

                        {imageBusy
                          ? "Przetwarzanie..."
                          : "Wybierz zdjęcie"}

                        <input
                          type="file"
                          accept="image/*"
                          onChange={handleRoomImage}
                          disabled={
                            !canEditRoom ||
                            roomSaving ||
                            imageBusy
                          }
                        />
                      </label>

                      {roomImage && (
                        <button
                          type="button"
                          className="room-remove-image"
                          onClick={() =>
                            setRoomImage(null)
                          }
                          disabled={
                            !canEditRoom ||
                            roomSaving ||
                            imageBusy
                          }
                        >
                          <Trash2 size={15} />
                          Usuń zdjęcie
                        </button>
                      )}

                      <small>
                        Zdjęcie zostanie automatycznie
                        pomniejszone.
                      </small>
                    </div>
                  </div>

                  {roomError && (
                    <div
                      className="room-form-error"
                      role="alert"
                    >
                      {roomError}
                    </div>
                  )}

                  {roomSuccess && (
                    <div
                      className="room-form-success"
                      role="status"
                    >
                      <Check size={16} />
                      {roomSuccess}
                    </div>
                  )}

                  <button
                    type="submit"
                    className="room-save-button"
                    disabled={
                      !canEditRoom ||
                      roomSaving ||
                      imageBusy ||
                      socketStatus !== "online" ||
                      !roomName.trim()
                    }
                  >
                    <Save size={17} />

                    {roomSaving
                      ? "Zapisywanie..."
                      : "Zapisz zmiany"}
                  </button>
                </form>
              </div>

              {/* MOTYW */}

              <div className="details-section">
                <h4>
                  <Palette size={16} />
                  MOTYW KOLORYSTYCZNY
                </h4>

                <p>
                  Kolor akcentów tej przeglądarki.
                </p>

                <div className="theme-options">
                  {themeOptions.map((option) => (
                    <button
                      type="button"
                      key={option.id}
                      className={`theme-option ${
                        themeId === option.id
                          ? "theme-option--active"
                          : ""
                      }`}
                      onClick={() =>
                        setThemeId(option.id)
                      }
                      style={{
                        "--swatch": option.hex,
                      } as CSSProperties}
                      aria-pressed={
                        themeId === option.id
                      }
                    >
                      <span className="theme-swatch">
                        {themeId === option.id && (
                          <Check size={16} />
                        )}
                      </span>

                      <span>
                        {option.label}
                      </span>
                    </button>
                  ))}
                </div>
              </div>

              {/* POWIADOMIENIA */}

              <div className="details-section">
                <h4>
                  POWIADOMIENIA
                </h4>

                <button
                  type="button"
                  className="settings-row"
                  onClick={() =>
                    setNotifications(
                      (current) => !current
                    )
                  }
                  aria-pressed={notifications}
                >
                  {notifications ? (
                    <Bell size={19} />
                  ) : (
                    <BellOff size={19} />
                  )}

                  <span>
                    Powiadomienia
                  </span>

                  <span
                    className={`toggle ${
                      notifications
                        ? "toggle-on"
                        : ""
                    }`}
                  >
                    <span />
                  </span>
                </button>

                <p className="setting-hint">
                  Na razie ustawienie demonstracyjne.
                </p>
              </div>

              <div className="details-notice">
                <ShieldCheck size={20} />

                <p>
                  Ustawienia pokoju są wspólne
                  dla uczestników. Motyw kolorystyczny
                  jest indywidualny.
                </p>
              </div>
            </div>
          )}
        </div>
      </aside>

      {/* ====================================
          TWORZENIE POKOJU
          ==================================== */}

      {createOpen && (
        <div className="modal-backdrop">
          <section
            className="create-modal"
            role="dialog"
            aria-modal="true"
            aria-labelledby="create-room-title"
          >
            <div className="modal-header">
              <div className="modal-icon">
                <Plus size={24} />
              </div>

              <button
                type="button"
                className="icon-button"
                aria-label="Zamknij"
                onClick={() => {
                  if (!createBusy) {
                    setCreateOpen(false);
                  }
                }}
                disabled={createBusy}
              >
                <X size={21} />
              </button>
            </div>

            <span className="eyebrow">
              NOWA PRZESTRZEŃ
            </span>

            <h2 id="create-room-title">
              Utwórz pokój
            </h2>

            <p className="modal-description">
              Nowy pokój pojawi się u wszystkich
              połączonych uczestników SoCalled.
            </p>

            <form
              onSubmit={createRoom}
              className="create-form"
            >
              <label htmlFor="room-name">
                Nazwa pokoju
              </label>

              <input
                id="room-name"
                value={newRoomName}
                onChange={(event) =>
                  setNewRoomName(
                    event.target.value
                  )
                }
                maxLength={28}
                placeholder="np. Nasza ekipa"
                required
                autoFocus
                disabled={createBusy}
              />

              <label className="checkbox-row">
                <input
                  type="checkbox"
                  checked={newRoomPrivate}
                  onChange={(event) =>
                    setNewRoomPrivate(
                      event.target.checked
                    )
                  }
                  disabled={createBusy}
                />

                <LockKeyhole size={18} />

                <span>
                  Pokój prywatny (demo)
                </span>
              </label>

              <p className="modal-hint">
                Prywatność jest obecnie
                tylko oznaczeniem demonstracyjnym.
              </p>

              {createError && (
                <div
                  className="room-form-error"
                  role="alert"
                >
                  {createError}
                </div>
              )}

              <button
                type="submit"
                className="primary-button"
                disabled={
                  !newRoomName.trim() ||
                  createBusy ||
                  socketStatus !== "online"
                }
              >
                <Plus size={19} />

                {createBusy
                  ? "Tworzenie..."
                  : "Utwórz pokój"}
              </button>
            </form>
          </section>
        </div>
      )}

      {/* ====================================
          PRZEKAZYWANIE WIADOMOŚCI
          ==================================== */}

      {forwardTarget && (
        <div className="modal-backdrop">
          <section
            className="create-modal socalled-forward-modal"
            role="dialog"
            aria-modal="true"
            aria-labelledby="forward-title"
          >
            <div className="modal-header">
              <div className="modal-icon">
                <Forward size={23} />
              </div>

              <button
                type="button"
                className="icon-button"
                onClick={cancelForward}
                disabled={forwardBusy}
                aria-label="Zamknij"
              >
                <X size={21} />
              </button>
            </div>

            <span className="eyebrow">
              PRZEKAZYWANIE WIADOMOŚCI
            </span>

            <h2 id="forward-title">
              Przekaż dalej
            </h2>

            <p className="modal-description">
              Wybierz pokój, w którym ma
              pojawić się kopia tej wiadomości.
            </p>

            <div className="socalled-forward-preview">
              <div className="socalled-forward-preview-top">
                <Forward size={15} />

                <strong>
                  {forwardTarget.author}
                </strong>
              </div>

              {forwardTarget.image && (
                <img
                  src={forwardTarget.image}
                  alt="Podgląd przekazywanego zdjęcia"
                />
              )}

              {forwardTarget.videoId && (
                <div className="socalled-forward-video-preview">
                  <Clapperboard size={19} />

                  <span>
                    Przekazywany film
                  </span>
                </div>
              )}

              <p>
                {forwardTarget.text ||
                  (forwardTarget.videoId
                    ? "🎬 Film bez podpisu"
                    : forwardTarget.image
                      ? "📷 Zdjęcie bez podpisu"
                      : "")}
              </p>
            </div>

            <form
              className="socalled-forward-form"
              onSubmit={submitForward}
            >
              <label htmlFor="forward-room">
                Pokój docelowy
              </label>

              <select
                id="forward-room"
                value={forwardRoomId}
                onChange={(event) =>
                  setForwardRoomId(
                    event.target.value
                  )
                }
                disabled={forwardBusy}
                required
              >
                {forwardRooms.map((room) => (
                  <option
                    key={room.id}
                    value={room.id}
                  >
                    {room.name}
                  </option>
                ))}
              </select>

              {forwardRooms.length === 0 && (
                <p className="socalled-forward-hint">
                  Utwórz jeszcze jeden pokój,
                  żeby przekazywać wiadomości.
                </p>
              )}

              {forwardError && (
                <div
                  className="room-form-error"
                  role="alert"
                >
                  {forwardError}
                </div>
              )}

              <button
                type="submit"
                className="primary-button"
                disabled={
                  !forwardRoomId ||
                  forwardBusy ||
                  socketStatus !== "online"
                }
              >
                <Forward size={18} />

                {forwardBusy
                  ? "Przekazywanie..."
                  : "Przekaż wiadomość"}
              </button>
            </form>
          </section>
        </div>
      )}

      {/* ====================================
          PODGLĄD I POBIERANIE PNG
          ==================================== */}

      {imageViewer && (
        <div
          className="socalled-image-lightbox"
          onClick={() =>
            setImageViewer(null)
          }
        >
          <section
            className="socalled-lightbox-content"
            role="dialog"
            aria-modal="true"
            aria-label={
              `Zdjęcie od ${imageViewer.author}`
            }
            onClick={(event) =>
              event.stopPropagation()
            }
          >
            <div className="socalled-lightbox-header">
              <span>
                Zdjęcie od {imageViewer.author}
              </span>

              <div className="socalled-lightbox-actions">
                <button
                  type="button"
                  className="socalled-download-button"
                  onClick={() =>
                    void saveMessageImage(
                      imageViewer.image,
                      imageViewer.messageId
                    )
                  }
                  title="Pobierz jako PNG"
                  aria-label="Pobierz jako PNG"
                >
                  <Download size={19} />
                </button>

                <button
                  type="button"
                  onClick={() =>
                    setImageViewer(null)
                  }
                  aria-label="Zamknij zdjęcie"
                >
                  <X size={22} />
                </button>
              </div>
            </div>

            <img
              src={imageViewer.image}
              alt={
                `Powiększone zdjęcie od ${imageViewer.author}`
              }
            />
          </section>
        </div>
      )}
    </div>
  );
}

export default App;
